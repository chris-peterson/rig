#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml", "textual"]
# ///
"""Launch Claude Code with a named set of plugins (a rig)."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

PROG = "rig"
PKG_ROOT = Path(__file__).resolve().parent.parent
PLUGIN_ROOT = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or PKG_ROOT)
INSTALL_COMMAND = "/rig:install-rig"


def rig_home() -> Path:
    return Path.home() / ".rig"


def fail(message: str) -> None:
    sys.exit(f"{PROG}: {message}")


def plugin_version() -> str:
    return json.loads((PLUGIN_ROOT / ".claude-plugin" / "plugin.json").read_text())["version"]


def git_read(*args: str) -> str:
    result = subprocess.run(["git", "-C", str(PKG_ROOT), *args], capture_output=True, text=True,
                            env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    return result.stdout.strip() if result.returncode == 0 else ""


def version_display() -> str:
    """The manifest version, marked as a prerelease when this copy is a git checkout."""
    version = plugin_version()
    if not (PKG_ROOT / ".git").exists():
        return version
    sha = git_read("rev-parse", "--short=7", "HEAD")
    if not sha:
        return f"{version}-dev"
    dirty = ".dirty" if git_read("status", "--porcelain") else ""
    return f"{version}-dev.g{sha}{dirty}"


def claude_subcommands() -> set[str]:
    """The subcommand names `claude --help` lists, aliases included (`plugin|plugins`)."""
    result = subprocess.run(["claude", "--help"], capture_output=True, text=True)
    if result.returncode != 0:
        fail(f"`claude --help` failed ({result.returncode}): {result.stderr.strip()}")
    names, listing = set(), False
    for line in result.stdout.splitlines():
        if line.startswith("Commands:"):
            listing = True
            continue
        match = listing and re.match(r"^  ([a-z][a-z|-]*)(?: |$)", line)
        if match:
            names.update(match.group(1).split("|"))
    return names


def exec_claude(args: list[str]) -> None:
    try:
        os.execvp("claude", ["claude", *args])
    except FileNotFoundError:
        fail("claude is not on PATH.")


def interactive(args: list[str]) -> bool:
    """A person at a terminal starting a session they will type into."""
    return sys.stdin.isatty() and sys.stderr.isatty() and not {"-p", "--print"} & set(args)


def yaml_module():
    try:
        import yaml
    except ImportError:
        fail("PyYAML is missing. Run rig through uv (`uv run --script`), as the installed wrapper does.")
    return yaml


def read_yaml(path: Path):
    yaml = yaml_module()
    try:
        return yaml.safe_load(path.read_text())
    except yaml.YAMLError as error:
        fail(f"{path} is not valid YAML: {error}")


def write_yaml(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(yaml_module().safe_dump(data, sort_keys=False, default_flow_style=False))


def rigs_file() -> Path:
    return rig_home() / "rigs.yml"


BASE = "base"
FULL = "full"
NONE = "none"  # stock Claude Code: no plugins at all, asked for at a terminal


def load_config() -> dict | None:
    """RIG-01, RIG-11: rigs.yml as {default, clones, rigs}, checked for shape; None when there is no file."""
    path = rigs_file()
    if not path.exists():
        return None
    data = read_yaml(path) or {}
    if not isinstance(data, dict):
        fail(f"{path} should hold a mapping with default, clones, and rigs.")
    rigs = data.get("rigs") or {}
    data["rigs"] = rigs
    data["clones"] = data.get("clones") or {}
    for kept, meaning in ((FULL, "every installed plugin"), (NONE, "a launch with no plugins")):
        if kept in rigs:
            fail(f"{path} defines a rig named {kept}, the name rig keeps for {meaning}. Rename that rig.")
    for name, rig in rigs.items():
        if rig is None:
            rig = rigs[name] = {}
        if not isinstance(rig, dict) or set(rig) - {"plugins"}:
            fail(f"rig {name} in {path}: a rig holds only `plugins`, and every launch loads the base rig with it. "
                 "Take out anything else, such as `extends`.")
        rig["plugins"] = rig.get("plugins") or []
        if not isinstance(rig["plugins"], list) or not all(isinstance(v, str) for v in rig["plugins"]):
            fail(f"rig {name} in {path}: plugins should be a list of names.")
    if rigs and BASE not in rigs:
        fail(f"{path} defines no rig named {BASE}, the rig every launch loads.")
    default = data.get("default") or []
    default = [default] if isinstance(default, str) else default
    if not isinstance(default, list) or not all(isinstance(v, str) for v in default):
        fail(f"default in {path} should be a list of rig names.")
    unknown = [name for name in default if name not in rigs and name != FULL]
    if unknown:
        fail(f"the default rigs in {path} include {', '.join(unknown)}, which {path} doesn't define.")
    data["default"] = selection(default)
    dismissed = data.get("dismissed") or []
    if not isinstance(dismissed, list) or not all(isinstance(v, str) for v in dismissed):
        fail(f"dismissed in {path} should be a list of plugin names.")
    data["dismissed"] = dismissed
    return data


def selection(names: list[str]) -> list[str]:
    """The rigs a launch adds to the base rig, in order, without repeats."""
    return list(dict.fromkeys(name for name in names if name != BASE))


def rig_order(rigs: dict) -> list[str]:
    """EDITOR-01: the base rig, the other rigs in alphabetical order, then full."""
    return [BASE, *sorted((name for name in rigs if name != BASE), key=str.casefold), FULL]


def label(selected: list[str], added: list[str] = (), removed: list[str] = ()) -> str:
    """The rigs a launch uses, then the plugins picked on their own (LAUNCH-11): `base + web + x@m - a@m`."""
    return " + ".join([BASE, *selected, *added]) + "".join(f" - {plugin_id}" for plugin_id in removed)


def summary(current: Plan, sep: str = ": ") -> str:
    """LAUNCH-02, LAUNCH-12: what a launch loads, `base + web: 9 plugins`, or `all 40 plugins` with full."""
    count = len(current.sources)
    plugins = f"{count} plugin{'' if count == 1 else 's'}"
    if FULL not in current.selected:
        return f"{label(current.selected, current.added, current.removed)}{sep}{plugins}"
    return f"all but {', '.join(current.removed)}{sep}{plugins}" if current.removed else f"all {plugins}"


def take_rigs(args: list[str], rigs: dict) -> tuple[list[str], list[str]]:
    """RIG-03: the rigs the leading arguments name, separated by spaces, commas, or both, and the arguments
    after them."""
    names = set(rigs) | {FULL, NONE}
    taken: list[str] = []
    for index, arg in enumerate(args):
        parts = [part for part in re.split(r"[,\s]+", arg) if part]
        if not parts or not all(part in names for part in parts):
            return selection(taken), args[index:]
        taken += parts
    return selection(taken), []


class Plan(NamedTuple):
    """What a launch with these rigs loads: each plugin with the rig that adds it, the ones not installed,
    and the pins."""
    selected: list[str]
    sources: dict[str, str]
    missing: list[str]
    offered: list[PinOffer]
    added: list[str] = []
    removed: list[str] = []


PICKED = "picked"


def plan(selected: list[str], rigs: dict, installed: set[str], pins: list[dict], cwd: Path, added: list[str] = (), removed: list[str] = ()) -> Plan:
    """RIG-02, RIG-03, RIG-10, LAUNCH-11: the base rig's plugins, then each named rig's, without repeats, less
    the plugins taken out, then the plugins picked on their own; full adds every installed plugin."""
    removed = list(dict.fromkeys(removed))
    sources = {plugin_id: BASE for plugin_id in rigs[BASE]["plugins"] if plugin_id not in removed}
    for name in selected:
        plugins = sorted(installed, key=str.casefold) if name == FULL else rigs[name]["plugins"]
        for plugin_id in plugins:
            if plugin_id not in removed:
                sources.setdefault(plugin_id, name)
    added = [p for p in dict.fromkeys(added) if p not in sources and p not in removed]
    sources.update({plugin_id: PICKED for plugin_id in added})
    in_rig = {plugin_id.split("@")[0] for plugin_id in sources}
    offered = [PinOffer(pin, pin["plugin"] in in_rig, cwd.is_relative_to(Path(pin["path"]))) for pin in pins]
    return Plan(selected, sources, [p for p in sources if p not in installed], offered, added, removed)


SANDBOX_SETTINGS = {"enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False,
                    "autoAllowBashIfSandboxed": True}


def take_flag(args: list[str], flag: str) -> tuple[bool, list[str]]:
    """SANDBOX-01, LAUNCH-07: whether the flag appears before any `--`, and the arguments without it."""
    end = args.index("--") if "--" in args else len(args)
    head = [a for a in args[:end] if a != flag]
    return len(head) < end, head + args[end:]



def settings_files(cwd: Path) -> list[Path]:
    """Claude Code settings files that can enable plugins for a session in cwd."""
    files = [Path.home() / ".claude" / "settings.json"]
    for folder in (cwd, *cwd.parents):
        files += [folder / ".claude" / "settings.json", folder / ".claude" / "settings.local.json"]
    return list(dict.fromkeys(f for f in files if f.is_file()))


def installed_plugins() -> dict:
    path = Path.home() / ".claude" / "plugins" / "installed_plugins.json"
    return json.loads(path.read_text()).get("plugins", {}) if path.exists() else {}


def installed_for(cwd: Path) -> set[str]:
    """Plugin ids installed at user scope, or at a project scope that covers cwd."""
    ids = set()
    for plugin_id, entries in installed_plugins().items():
        for entry in entries:
            project = entry.get("projectPath")
            if entry.get("scope") == "user" or (project and cwd.is_relative_to(Path(project).resolve())):
                ids.add(plugin_id)
    return ids


def known_plugin_ids(cwd: Path) -> set[str]:
    """Every plugin id a session in cwd could load: each one installed, and each one any settings file names."""
    ids = set(installed_plugins())
    for path in settings_files(cwd):
        try:
            ids.update((json.loads(path.read_text()).get("enabledPlugins") or {}).keys())
        except json.JSONDecodeError as error:
            fail(f"{path} is not valid JSON: {error}")
    return ids


def overlay(rig_ids: list[str], pinned: set[str], known: set[str], sandbox: bool, removed: list[str] = ()) -> dict:
    """RIG-04, PIN-08, SANDBOX-01, LAUNCH-11: settings that enable the rig's plugins, turn off the installed copy
    of each loaded pin and each plugin taken out in the picker, and turn on the sandbox with no unsandboxed
    commands when asked.

    Every other plugin is left to the settings files, since a --settings value outranks them all and would
    keep a plugin enabled mid-session from loading."""
    enabled = {plugin_id: False for plugin_id in sorted(known) if plugin_id.split("@")[0] in pinned}
    enabled.update({plugin_id: False for plugin_id in removed})
    enabled.update({plugin_id: True for plugin_id in rig_ids})
    return {"enabledPlugins": enabled, **({"sandbox": SANDBOX_SETTINGS} if sandbox else {})}


def install(plugins: list[str]) -> None:
    """RIG-08: install the plugins the user confirmed the launch with."""
    for plugin in plugins:
        if subprocess.run(["claude", "plugin", "install", plugin]).returncode != 0:
            fail(f"`claude plugin install {plugin}` failed; launch refused.")


AUTO_MODE_SERVER = "CLAUDE_CODE_AUTO_MODE_SERVER"


def auto_mode_server_off(loaded: list[dict], cwd: Path) -> list[str]:
    """PIN-11: the launch-summary line when this launch turns the auto mode server off, else nothing."""
    cwd = cwd.resolve()
    here = [pin["plugin"] for pin in loaded
            if cwd.is_relative_to(Path(pin["path"]).resolve()) or Path(pin["path"]).resolve().is_relative_to(cwd)]
    if not here or AUTO_MODE_SERVER in os.environ:
        return []
    # Auto mode refuses edits inside a --plugin-dir checkout under the session's folder:
    # https://github.com/anthropics/claude-code/issues/95982
    os.environ[AUTO_MODE_SERVER] = "0"
    return [f"auto mode: {AUTO_MODE_SERVER}=0, since {', '.join(here)} {'is' if len(here) == 1 else 'are'} pinned here"]


def settings_flag(args: list[str]) -> bool:
    return any(a == "--settings" or a.startswith("--settings=") for a in args)


def ensure_config(args: list[str]) -> dict:
    """SETUP-01, SETUP-06: the rig definitions, after first-run setup at a terminal when there are none."""
    config = load_config()
    if config is None or not config["rigs"]:
        if not interactive(args):
            fail("no rigs are defined, and setup needs a terminal; run `rig setup`.")
        setup()
        config = load_config()
        if config is None or not config["rigs"]:
            fail("setup closed without saving any rigs; launch stopped. Run `rig setup` to try again.")
    return config


def launch(selected: list[str] | None, args: list[str]) -> None:
    """RIG-06, LAUNCH-06, SANDBOX-01: launch the base rig with the named rigs, or with the default ones; at a
    terminal, stay Claude Code's parent so a switch can relaunch the conversation with other rigs."""
    sandbox_flag, args = take_flag(args, "--sandbox")
    select_flag, args = take_flag(args, "--select")
    if select_flag and not interactive(args):
        fail("--select opens a picker, so it needs a terminal; name the rigs instead: rig use <rig>...")
    if settings_flag(args):
        fail("rig starts Claude Code with its own --settings, and a second --settings replaces the first. "
             "Put these settings in ~/.claude/settings.json or the project's .claude/settings.json.")
    config = ensure_config(args)
    if selected is None:
        selected = config["default"]
    if not interactive(args):
        exec_claude(claude_args(selected, args, sandbox_flag)[1])
    request = switch_file()
    try:
        while True:
            selected, arguments = claude_args(selected, args, sandbox_flag, select_flag)
            select_flag = False
            status = run_claude(arguments, {SWITCH_ENV: str(request), CURRENT_RIG_ENV: " ".join(selected) or BASE})
            switch = take_switch(request)
            if switch is None:
                raise SystemExit(status)
            selected, args = switch["rigs"], ["--resume", switch["session"], switched_prompt(switch["rigs"])]
            print(f"{PROG}: switching to {label(selected)}, resuming this conversation", file=sys.stderr)
    finally:
        request.unlink(missing_ok=True)


def claude_args(selected: list[str], args: list[str], sandbox_flag: bool, select: bool = False) -> tuple[list[str], list[str]]:
    """RIG-04, RIG-08, RIG-09, RIG-12, PIN-10, LAUNCH-01..02, LAUNCH-05, LAUNCH-07: the rigs the launch uses and
    the arguments that start Claude Code with them, once their plugins are installed and the pins chosen."""
    config = load_config()
    rigs = config["rigs"]
    unknown = [name for name in selected if name not in rigs and name not in (FULL, NONE)]
    if unknown:
        fail(f"no rig named {', '.join(unknown)}. Rigs: {', '.join(rig_order(rigs))}")
    if NONE in selected:
        return selected, stock_args(selected, args, sandbox_flag)
    cwd = Path.cwd()
    installed = installed_for(cwd)
    pins = checked_pins()
    current = plan(selected, rigs, installed, pins, cwd)
    if not interactive(args):
        if current.missing:
            fail(f"{label(selected)} names plugins that aren't installed: {', '.join(current.missing)}. "
                 "Install them with `claude plugin install <plugin>`, or launch at a terminal to be asked.")
        chosen = [(offer.pin, offer.in_rig) for offer in current.offered]
    elif select or current.missing or any(not offer.locked for offer in current.offered):
        plan_for = lambda names, *picks: plan(names, rigs, installed, pins, cwd, *picks)
        if not select:
            answer = launch_app(plan_for, rig_order(rigs), current, sandbox_flag).run()
        while select:
            everything = sorted(installed, key=str.casefold)
            columns = [{"name": name, "default": name in config["default"],
                        "plugins": everything if name == FULL else rigs[name]["plugins"]} for name in rig_order(rigs)]
            answer = select_app(plan_for, columns, everything, pins, current, sandbox_flag, invocation()).run()
            if answer is None or answer[0] != EDIT:
                break
            setup()
            config = load_config()
            rigs = config["rigs"]
            current = plan([name for name in answer[1] if name in rigs or name == FULL], rigs, installed, pins, cwd, *answer[2:])
        if answer is None:
            fail("launch cancelled.")
        selected, chosen, *picks = answer
        current = plan(selected, rigs, installed, pins, cwd, *picks)
    else:
        chosen = [(offer.pin, True) for offer in current.offered]
    plugins = list(current.sources)
    install(current.missing)
    turned_off = [p for p in turn_off_user_plugins() if p not in plugins]
    loaded = [pin for pin, load in chosen if load]
    replaced = {pin["plugin"] for pin in loaded}
    enabled = [p for p in plugins if p.split("@")[0] not in replaced]
    stray = [f"turned off in {display(user_settings_file())}: {', '.join(turned_off)}"] if turned_off else []
    print(f"rig: {summary(current, ', ')}", *describe_pins(chosen), *stray, *auto_mode_server_off(loaded, cwd),
          f"sandbox: {'on' if sandbox_flag else 'off'}", sep="\n", file=sys.stderr)
    plugin_dirs = [arg for pin in loaded for arg in ("--plugin-dir", pin["path"])]
    settings = overlay(enabled, replaced, known_plugin_ids(cwd), sandbox_flag, current.removed)
    return selected, ["--settings", json.dumps(settings), *plugin_dirs, *args]


def stock_args(selected: list[str], args: list[str], sandbox_flag: bool) -> list[str]:
    """RIG-15..17: Claude Code with every plugin it knows of turned off, pins and the base rig's included, once
    the user at the terminal confirms it."""
    if selected != [NONE]:
        fail(f"{NONE} launches Claude Code with no plugins, so it goes alone: rig use {NONE}")
    warning = (f"{NONE} launches stock Claude Code: no plugins at all, not the base rig's, and no pins. "
               "The hooks, skills, and guardrails they bring won't be there.")
    if not interactive(args):
        fail(f"{warning} It needs someone at a terminal to confirm it.")
    sys.stderr.write(f"{PROG}: {warning}\nLaunch with no plugins? [y/N] ")
    sys.stderr.flush()
    if sys.stdin.readline().strip().lower() not in ("y", "yes"):
        fail("launch cancelled.")
    cwd = Path.cwd()
    print(f"rig: {NONE}, no plugins", *describe_pins([(pin, False) for pin in read_pins()]),
          f"sandbox: {'on' if sandbox_flag else 'off'}", sep="\n", file=sys.stderr)
    settings = {"enabledPlugins": {plugin_id: False for plugin_id in sorted(known_plugin_ids(cwd))},
                **({"sandbox": SANDBOX_SETTINGS} if sandbox_flag else {})}
    return ["--settings", json.dumps(settings), *args]


SWITCH_ENV = "RIG_SWITCH_FILE"
CURRENT_RIG_ENV = "RIG_CURRENT"


def switch_file() -> Path:
    """Where a session this rig process launched records a switch: one file per rig process."""
    return rig_home() / "switch" / f"{os.getpid()}.yml"


def take_switch(path: Path) -> dict | None:
    """SWITCH-02: the switch a session recorded before it exited, removed once read."""
    if not path.exists():
        return None
    switch = read_yaml(path)
    path.unlink()
    return switch


def switched_prompt(selected: list[str]) -> str:
    """SWITCH-02: the turn a relaunch opens with, so the resumed conversation doesn't end on "type /exit"."""
    return (f"rig relaunched this conversation with {label(selected)}; the switch is done. "
            "In a line or two, confirm it and say what this session can do now that it couldn't before, "
            "then carry on with what we were doing.")


def run_claude(args: list[str], env: dict[str, str]) -> int:
    """LAUNCH-06: run Claude Code as a child, leaving Ctrl-C to it, and return its exit status.

    The handlers are Python functions rather than SIG_IGN, since an ignored signal stays ignored across exec."""
    import signal
    try:
        child = subprocess.Popen(["claude", *args], env={**os.environ, **env})
    except FileNotFoundError:
        fail("claude is not on PATH.")
    forward = lambda signum, _frame: child.send_signal(signum)
    previous = {sig: signal.signal(sig, handler) for sig, handler in (
        (signal.SIGINT, lambda *_: None), (signal.SIGQUIT, lambda *_: None),
        (signal.SIGTERM, forward), (signal.SIGHUP, forward))}
    try:
        status = child.wait()
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
    return 128 - status if status < 0 else status


def cmd_switch(args: list[str]) -> int:
    """SWITCH-01, SWITCH-03..05: record the rigs a session switches to once Claude Code exits."""
    session = None
    if "--session" in args:
        at = args.index("--session")
        session = args[at + 1] if at + 1 < len(args) else None
        args = args[:at] + args[at + 2:]
    if not session:
        fail("switch takes rig names and the session id: rig switch [<rig>...] --session <id>")
    config = load_config()
    rigs = config["rigs"] if config else {}
    launched = os.environ.get(CURRENT_RIG_ENV)
    current = selection((launched or "").split())
    if not args:
        for name in rig_order(rigs) if rigs else []:
            in_use = launched is not None and (name == BASE or name in current)
            print(f"{name}{' (this session)' if in_use else ''}")
        return 0
    selected, rest = take_rigs(args, rigs)
    if rest:
        fail(f"no rig named {rest[0]}. Rigs: {', '.join(rig_order(rigs)) if rigs else 'none'}")
    request = os.environ.get(SWITCH_ENV)
    if not request:
        fail(f"this session wasn't launched by rig at a terminal, so rig can't relaunch it. Exit Claude Code, "
             f"then run: rig use {' '.join(selected) or BASE} --resume {session}")
    if selected == current:
        print(f"{PROG}: this session already uses {label(selected)}.")
        return 0
    write_yaml(Path(request), {"rigs": selected, "session": session})
    print(f"{PROG}: exit Claude Code (/exit), and rig relaunches this conversation with {label(selected)}.")
    return 0


def cmd_use(args: list[str]) -> int:
    """RIG-05."""
    if not args or args[0].startswith("-"):
        fail("use takes one or more rig names: rig use <rig>... [claude args...]")
    rigs = ensure_config(args)["rigs"]
    selected, rest = take_rigs(args, rigs)
    if len(rest) == len(args):
        fail(f"no rig named {args[0]}. Rigs: {', '.join(rig_order(rigs))}")
    launch(selected, rest)


def cmd_list(args: list[str]) -> int:
    """RIG-07, RIG-13, RIG-14."""
    if args not in ([], ["--json"], ["--graph"]):
        fail("list takes --json or --graph.")
    config = load_config()
    if config is None or not config["rigs"]:
        if args == ["--json"]:
            print(json.dumps({"default": [], "rigs": []}))
        else:
            print("No rigs defined. Run: rig setup")
        return 0
    installed = sorted(installed_for(Path.cwd()), key=str.casefold)
    rigs = [{"name": name, "built_in": name in BUILT_IN, "default": name in config["default"],
             "plugins": installed if name == FULL else config["rigs"][name]["plugins"]}
            for name in rig_order(config["rigs"])]
    pins = read_pins()
    if args == ["--json"]:
        print(json.dumps({"default": config["default"], "rigs": rigs}, indent=2))
    elif args == ["--graph"]:
        print(graph(rigs[:-1], installed, pins))
    else:
        pinned = pinned_names(pins)
        for rig in rigs:
            note = " (every launch)" if rig["name"] == BASE else " (default)" if rig["default"] else ""
            plugins = ", ".join(plugin_cell(p, pinned) for p in rig["plugins"]) or "none"
            print(f"{rig['name']}{note}")
            print(f"  plugins: {'every installed plugin' if rig['name'] == FULL else plugins}")
    return 0


PIN = "📌"


def cells(text: str) -> int:
    """The terminal columns text takes: two for a wide character such as 📌."""
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def pad(text: str, width: int) -> str:
    return text + " " * max(width - cells(text), 0)


def pinned_names(pins: list[dict]) -> set[str]:
    return {pin["plugin"] for pin in pins}


def plugin_cell(plugin_id: str, pinned: set[str]) -> str:
    """PIN-12: the one way rig writes a plugin's name, marked 📌 when a checkout is pinned for it."""
    return f"{plugin_id} {PIN}" if plugin_id.split("@")[0] in pinned else plugin_id


Piece = tuple[str, int | None]


class Graph(NamedTuple):
    """RIG-14, LAUNCH-07: plugins down the side and rigs across the top, laid out once for `rig list --graph`
    and the picker. A row or the header is a list of pieces, each (text, column): column -1 is the plugin's
    name, 0.. a rig, and None the gap between them."""
    rigs: list[dict]
    rows: list[str]
    labels: list[str]
    heads: list[str]
    width: int

    def header(self) -> list[Piece]:
        return [(pad("plugin", self.width), -1), *self.cells([(head, i) for i, head in enumerate(self.heads)])]

    def row(self, index: int) -> list[Piece]:
        plugin_id = self.rows[index]
        marks = [(("●" if plugin_id in rig["plugins"] else "·").center(len(head)), i)
                 for i, (rig, head) in enumerate(zip(self.rigs, self.heads))]
        return [(pad(self.labels[index], self.width), -1), *self.cells(marks)]

    @staticmethod
    def cells(pieces: list[Piece]) -> list[Piece]:
        return [part for piece in pieces for part in (("  ", None), piece)]

    def column_at(self, x: int) -> int | None:
        """The column a terminal cell x falls in, a rig's gap counting as the rig's."""
        at = 0
        for text, column in self.header():
            at += cells(text)
            if x < at:
                return column
        return None

    def text(self) -> str:
        lines = [self.header()] + [self.row(i) for i in range(len(self.rows))]
        return "\n".join("".join(text for text, _ in pieces).rstrip() for pieces in lines)


def graph_of(rigs: list[dict], installed: list[str], pins: list[dict]) -> Graph:
    """Each rig's plugins together, then the installed plugins no rig names, then pins for none of those."""
    rows = list(dict.fromkeys(p for rig in rigs for p in rig["plugins"]))
    rows += [p for p in installed if p not in rows]
    shown = {p.split("@")[0] for p in rows}
    rows += [pin["plugin"] for pin in pins if pin["plugin"] not in shown]
    labels = [plugin_cell(p, pinned_names(pins)) for p in rows]
    heads = [("★" if rig["default"] else "") + rig["name"] for rig in rigs]
    return Graph(rigs, rows, labels, heads, max([cells(label) for label in labels] + [len("plugin")]))


def graph(rigs: list[dict], installed: list[str], pins: list[dict] = ()) -> str:
    """RIG-14: plugins down the side, rigs across the top, a dot where a rig loads the plugin."""
    return graph_of(rigs, installed, list(pins)).text()


def pins_file() -> Path:
    return rig_home() / "pins.yml"


def read_pins() -> list[dict]:
    """Each pin as {path, plugin, pinned_at}, in path order."""
    path = pins_file()
    entries = (read_yaml(path) or []) if path.exists() else []
    if not isinstance(entries, list):
        fail(f"{path} should hold a list of pins.")
    return sorted(entries, key=lambda e: str(e["path"]).casefold())


def write_pins(pins: list[dict]) -> None:
    write_yaml(pins_file(), sorted(pins, key=lambda e: str(e["path"]).casefold()))


def display(path: Path | str) -> str:
    path = Path(path)
    for home in (Path.home(), Path.home().resolve()):
        if path.is_relative_to(home):
            return f"~/{path.relative_to(home)}"
    return str(path)


AGE_UNITS = (("year", 365 * 86400), ("month", 30 * 86400), ("week", 7 * 86400),
             ("day", 86400), ("hour", 3600), ("minute", 60))


def age(pinned_at: str) -> str:
    """How long ago, in the largest whole unit: "3 days ago"."""
    from datetime import datetime, timezone
    seconds = (datetime.now(timezone.utc) - datetime.fromisoformat(pinned_at)).total_seconds()
    for unit, size in AGE_UNITS:
        if seconds >= size:
            count = int(seconds // size)
            return f"{count} {unit}{'' if count == 1 else 's'} ago"
    return "just now"


def manifest_name(path: Path) -> str | None:
    manifest = path / ".claude-plugin" / "plugin.json"
    return json.loads(manifest.read_text()).get("name") if manifest.is_file() else None


class Unresolved(Exception):
    """A plugin name that doesn't map to one local clone; the message says why."""


def repo_key(url: str) -> tuple[str, str]:
    """(host, repo path) for an https or scp-style git URL."""
    match = re.match(r"^(?:https?://|ssh://)?(?:[^@/]+@)?([^/:]+)[:/](.+?)(?:\.git)?/?$", url)
    if not match:
        raise Unresolved(f"can't read a host and repo path from {url}")
    return match.group(1), match.group(2)


def marketplace_plugins() -> list[tuple[str, dict, dict]]:
    """(marketplace, its known_marketplaces.json entry, plugin entry) for every plugin a known marketplace lists."""
    known = Path.home() / ".claude" / "plugins" / "known_marketplaces.json"
    if not known.exists():
        raise Unresolved(f"{known} does not exist, so plugin names can't be looked up. Pass a path.")
    plugins = []
    for market, entry in json.loads(known.read_text()).items():
        location = Path(entry["installLocation"])
        manifest = location if location.is_file() else location / ".claude-plugin" / "marketplace.json"
        if not manifest.is_file():
            raise Unresolved(f"marketplace {market} has no manifest at {manifest}")
        plugins += [(market, entry, plugin) for plugin in json.loads(manifest.read_text()).get("plugins", [])]
    return plugins


def marketplace_sources(name: str) -> list[tuple[str, str]]:
    """(git URL, path within the repo) for each known marketplace entry named <name>."""
    sources = []
    for market, entry, plugin in marketplace_plugins():
        if plugin.get("name") != name:
            continue
        source = plugin["source"]
        if isinstance(source, str):
            source, subdir = entry["source"], source
        else:
            subdir = source.get("path", "")
        if source["source"] == "github":
            url = f"https://github.com/{source['repo']}.git"
        elif source["source"] in ("url", "git-subdir", "git"):
            url = source["url"]
        else:
            raise Unresolved(f"{name} in {market} comes from a {source['source']} source; pass a path.")
        sources.append((url, subdir.removeprefix("./")))
    return sources


def origin_url(clone: Path) -> str:
    return subprocess.run(["git", "-C", str(clone), "remote", "get-url", "origin"],
                          capture_output=True, text=True).stdout.strip()


def resolve_name(name: str, clones: dict[str, Path]) -> Path:
    """PIN-02: the local clone of the plugin's marketplace source repo."""
    sources = marketplace_sources(name)
    if not sources:
        raise Unresolved(f"no known marketplace lists a plugin named {name}, and ./{name} doesn't exist. Pass a path.")
    candidates = {}
    for url, subdir in sources:
        host, repo = repo_key(url)
        if host not in clones:
            raise Unresolved(f"{name} comes from {url}, and {rigs_file()} names no clone folder for {host} "
                             f"under clones. Add `{host}: <folder holding your {host} clones>` there, or pass a path.")
        clone = clones[host] / repo
        if not clone.is_dir():
            raise Unresolved(f"{name} comes from {url}, which isn't cloned at {clone}. Clone it there or pass a path.")
        origin = origin_url(clone)
        if not origin or repo_key(origin) != (host, repo):
            raise Unresolved(f"{clone} has origin {origin or 'unset'}, not {url}.")
        candidates[clone / subdir if subdir else clone] = url
    if len(candidates) > 1:
        raise Unresolved(f"{name} resolves to {len(candidates)} checkouts; pass one: "
                         + ", ".join(map(str, candidates)))
    return next(iter(candidates))


def clone_roots() -> dict[str, Path]:
    config = load_config()
    return {host: Path(folder).expanduser() for host, folder in (config or {}).get("clones", {}).items()}


def show_pins() -> int:
    """PIN-06."""
    pins = read_pins()
    if not pins:
        print("No plugins pinned.")
        return 0
    print(*pin_lines([(pin, [] if Path(pin["path"]).is_dir() else ["missing"]) for pin in pins]), sep="\n")
    return 0


def cmd_pin(args: list[str]) -> int:
    """PIN-01..03, PIN-06."""
    if not args:
        return show_pins()
    from datetime import datetime, timezone
    pins = read_pins()
    for arg in args:
        path = Path(arg).expanduser().resolve()
        if not path.exists():
            if "/" in arg:
                fail(f"{path} does not exist.")
            try:
                path = resolve_name(arg, clone_roots()).resolve()
            except Unresolved as unresolved:
                fail(str(unresolved))
        name = manifest_name(path)
        if name is None:
            fail(f"{path} holds no plugin manifest (.claude-plugin/plugin.json); pin refused.")
        same = next((p for p in pins if p["plugin"] == name), None)
        if same and Path(same["path"]) == path:
            print(f"{PROG}: {name} is already pinned at {display(path)}")
            continue
        if same:
            fail(f"{name} is already pinned at {display(same['path'])}. Unpin it first: rig unpin {name}")
        pins.append({"path": str(path), "plugin": name,
                     "pinned_at": datetime.now(timezone.utc).isoformat(timespec="seconds")})
        print(f"{PROG}: pinned {name} at {display(path)}")
    write_pins(pins)
    return 0


def cmd_unpin(args: list[str]) -> int:
    """PIN-05."""
    if not args:
        fail("unpin takes a pinned path or plugin name: rig unpin <path|name>")
    pins = read_pins()
    for arg in args:
        path = Path(arg).expanduser().resolve()
        matches = [p for p in pins if Path(p["path"]) == path or p["plugin"] == arg or Path(p["path"]).name == arg]
        if not matches:
            fail(f"{arg} is not pinned. Pinned: {', '.join(p['plugin'] for p in pins) or 'none'}")
        if len(matches) > 1:
            fail(f"{arg} matches {len(matches)} pins; pass the path: " + ", ".join(p["path"] for p in matches))
        pins.remove(matches[0])
        print(f"{PROG}: unpinned {matches[0]['plugin']} ({display(matches[0]['path'])})")
    write_pins(pins)
    return 0


# revdiff's Dracula colors (`revdiff --theme=dracula --dump-theme`), copied so rig needs nothing from revdiff.
DRACULA = {"background": "#282a36", "foreground": "#f8f8f2", "accent": "#bd93f9", "muted": "#6272a4",
           "add": "#50fa7b", "remove": "#ff5555", "modify": "#ffb86c", "annotation": "#f1fa8c", "fixed": "#8be9fd"}
MUTED, FIXED, NOTE, WARN = DRACULA["muted"], DRACULA["fixed"], DRACULA["annotation"], DRACULA["modify"]


def use_theme(app) -> None:
    """Style the app as revdiff's Dracula theme does."""
    from textual.theme import Theme
    c = DRACULA
    app.register_theme(Theme(
        name="rig", primary=c["accent"], secondary=c["muted"], accent=c["accent"], warning=c["modify"],
        error=c["remove"], success=c["add"], foreground=c["foreground"], background=c["background"],
        surface=c["background"], panel=c["background"], dark=True,
        variables={"border": c["accent"], "border-blurred": c["muted"],
                   "footer-background": c["accent"], "footer-foreground": c["background"],
                   "footer-key-foreground": c["background"], "footer-description-foreground": c["background"],
                   "block-cursor-background": c["accent"], "block-cursor-foreground": c["foreground"],
                   "block-cursor-text-style": "bold", "button-color-foreground": c["background"]}))
    app.theme = "rig"


BUILT_IN = {BASE: "built-in, every launch", FULL: "built-in, every installed plugin"}


class PinOffer(NamedTuple):
    pin: dict
    in_rig: bool
    here: bool

    @property
    def selected(self) -> bool:
        """PIN-07..09: selected on the launch confirmation when the rigs include it or the launch starts inside it."""
        return self.in_rig or self.here

    @property
    def locked(self) -> bool:
        """PIN-08: a pin the rigs include loads, unless the launch starts inside it."""
        return self.in_rig and not self.here


def checked_pins() -> list[dict]:
    """PIN-04: the pins, stopping the launch on one whose checkout is gone."""
    pins = read_pins()
    for pin in pins:
        if not Path(pin["path"]).is_dir():
            fail(f"pinned plugin {pin['plugin']} is missing at {display(pin['path'])}. "
                 f"Unpin it: rig unpin {pin['plugin']}")
    return pins


def launch_app(plan_for, names: list[str], initial: Plan, sandbox: bool):
    """LAUNCH-05: one confirmation for the launch: the rigs, which the user can add to or take from, the plugins
    they load, and the pins they leave to choose. Exits with (the rigs, each pin and whether to load it), or None
    when cancelled."""
    from rich.text import Text
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import VerticalScroll
    from textual.widgets import Footer, SelectionList, Static
    from textual.widgets.selection_list import Selection

    def rig_option(name: str) -> Selection:
        text = Text.assemble((name, f"italic {FIXED}"), (f"  {BUILT_IN[name]}", MUTED)) if name in BUILT_IN else Text(name)
        return Selection(text, name, name == BASE or name in initial.selected, disabled=name == BASE)

    def plugin_line(current: Plan, plugin_id: str) -> Text:
        line = Text.assemble(plugin_id, (f"  from {current.sources[plugin_id]}", MUTED))
        offer = next((o for o in current.offered if o.in_rig and o.pin["plugin"] == plugin_id.split("@")[0]), None)
        if offer and offer.locked:
            line.append(f"  {PIN} {display(offer.pin['path'])}", NOTE)
        elif offer:
            line.append(f"  {PIN} here; choose below", NOTE)
        if plugin_id in current.missing:
            line.append("  not installed; installs at launch", WARN)
        return line

    def pin_option(index: int, offer: PinOffer, load: bool) -> Selection:
        label_text = Text.assemble(f"{PIN} {offer.pin['plugin']}", (f"  {display(offer.pin['path'])}", MUTED))
        if offer.in_rig:
            label_text.append("  holds this folder; unselected, the installed copy loads", MUTED)
        elif offer.here:
            label_text.append("  holds this folder", MUTED)
        return Selection(label_text, index, load)

    class LaunchConfirmation(App):
        TITLE = "rig"
        ENABLE_COMMAND_PALETTE = False
        BINDINGS = [Binding("enter", "launch", "Launch", priority=True),
                    Binding("q", "cancel", "Cancel")]
        CSS = """
        Screen { border: round $border; border-title-align: center; border-title-color: $text; }
        #rigs { height: auto; max-height: 40%; border: round $border-blurred; }
        #plugins { height: auto; max-height: 40%; border: round $border-blurred; padding: 0 1; }
        #pins { height: auto; max-height: 1fr; border: round $border-blurred; }
        #rigs:focus, #pins:focus { border: round $border; }
        #sandbox { padding: 0 1; }
        """

        def __init__(self):
            super().__init__()
            use_theme(self)
            self.current = initial
            self.pin_choices: dict[str, bool] = {}

        def compose(self) -> ComposeResult:
            rigs = SelectionList(*(rig_option(name) for name in names), id="rigs")
            rigs.border_title = "rigs (space adds or takes away)"
            yield rigs
            with VerticalScroll(id="plugins") as panel:
                panel.can_focus = False
                yield Static(id="plugin-lines")
            pins = SelectionList(id="pins")
            pins.border_title = f"{PIN} to load (space toggles)"
            yield pins
            yield Static(f"sandbox: {'on' if sandbox else 'off'}", id="sandbox")
            yield Footer()

        def on_mount(self) -> None:
            self.screen.border_title = "rig: launch"
            self.show()
            pins = self.query_one("#pins", SelectionList)
            if pins.display:
                pins.focus()

        def load(self, offer: PinOffer) -> bool:
            return offer.locked or self.pin_choices.get(offer.pin["path"], offer.selected)

        def show(self) -> None:
            current = self.current
            self.query_one("#plugins").border_title = summary(current)
            lines = [plugin_line(current, plugin_id) for plugin_id in current.sources]
            self.query_one("#plugin-lines", Static).update(Text("\n").join(lines) or Text("no plugins", "dim"))
            pins = self.query_one("#pins", SelectionList)
            pins.clear_options()
            pins.add_options([pin_option(index, offer, self.load(offer))
                              for index, offer in enumerate(current.offered) if not offer.locked])
            pins.display = pins.option_count > 0
            if pins.option_count:
                pins.highlighted = 0

        def on_selection_list_selection_toggled(self, event: SelectionList.SelectionToggled) -> None:
            if event.selection_list.id == "rigs":
                chosen = set(event.selection_list.selected)
                self.current = plan_for([name for name in names if name in chosen and name != BASE])
                self.show()
            else:
                offer = self.current.offered[event.selection.value]
                self.pin_choices[offer.pin["path"]] = event.selection.value in event.selection_list.selected

        def action_launch(self) -> None:
            self.exit((self.current.selected, [(offer.pin, self.load(offer)) for offer in self.current.offered]))

        def action_cancel(self) -> None:
            self.exit(None)

    return LaunchConfirmation()


CURSOR_ROW = "#44475a"  # Dracula's current-line color
EDIT = "edit"  # what the picker exits with to open the rig editor, along with what's chosen so far
ON, PARTIAL, OFF = "on", "partial", "off"  # how much of a rig the picker's launch loads
HEADER_LINES = 2  # the picker's rig names and the ✓ row under them
RIGS = -1  # the picker's cursor row when it's on the rig names
EXHAUST, EXHAUST_CELLS = "  ·∙•●•∙·", 5  # the 🚀's trail, sliding one character a frame


def invocation() -> str:
    """LAUNCH-07: the command line rig was called with, as the user typed it: `claude …` when the claude
    function ran it, else `rig …`."""
    import shlex
    args = sys.argv[1:]
    return shlex.join(args if args[:1] == ["claude"] else [PROG, *args])


def select_app(plan_for, columns: list[dict], installed: list[str], pins: list[dict], initial: Plan, sandbox: bool, title: str = f"{PROG} --select"):
    """LAUNCH-07..11: pick the rigs on the graph `rig list --graph` prints, `full` among them. One cursor sits
    on a rig's name or a plugin's row, and space, enter, or a click toggles what it's on: a rig (`full` alone)
    or a plugin, a pinned one opening its pin. e opens the rig editor, and l or the 🚀 launches. The header is the command line that opened it. Exits with (the rigs, each pin and
    whether to load it, the plugins picked, the plugins taken out), or (EDIT, the rigs, picked, taken out), or
    None when cancelled."""
    from rich.text import Text
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, ScrollableContainer, Vertical
    from textual.geometry import Region
    from textual.screen import ModalScreen
    from textual.widget import Widget
    from textual.widgets import Button, Footer, Static

    names = [rig["name"] for rig in columns]
    defaults = any(rig["default"] for rig in columns)

    def legend(states: list[str]) -> Text:
        """LAUNCH-07, LAUNCH-11: what the marks on screen mean, at the right end of the ✓ row: ★ when a rig is a
        default, ✓ when a rig besides base (which always loads) carries one, ◐ while a rig does."""
        keys = [(("★", ""), "default", defaults), (("✓", f"bold {DRACULA['accent']}"), "loads", ON in states[1:]),
                (("◐", f"bold {NOTE}"), "part", PARTIAL in states)]
        text = Text()
        for mark, meaning, shown in keys:
            if shown:
                text.append("  " if text else "")
                text.append(*mark)
                text.append(f" = {meaning}", MUTED)
        return text

    layout = graph_of(columns, installed, pins)

    class Picker(Widget, can_focus=True):
        """The graph, with one cursor: on a rig's name (row RIGS) or on a plugin's row, where a click would land."""

        BINDINGS = [Binding("up", "move(-1)", show=False), Binding("down", "move(1)", show=False),
                    Binding("left", "across(-1)", show=False), Binding("right", "across(1)", show=False),
                    Binding("tab", "cycle(1)", show=False), Binding("shift+tab", "cycle(-1)", show=False),
                    Binding("space", "activate", "Toggle"), Binding("enter", "activate", show=False),
                    Binding("e", "edit", "Edit rigs")]

        def __init__(self):
            super().__init__(id="graph")
            self.column = 1
            self.row = RIGS

        def render(self) -> Text:
            """The rig names, a ✓ under each rig the launch loads whole and a ◐ under each it loads part of, then
            the plugins; the cursor shades the rig or the row it's on, apart from what's chosen."""
            app, current = self.app, self.app.current
            states = [app.state(column) for column in range(len(names))]
            cursor = f"on {CURSOR_ROW}"
            on_rig = lambda column: self.row == RIGS and column == self.column
            out = Text(no_wrap=True)
            for text, column in layout.header():
                style = "bold" if column == -1 else ""
                if column is not None and column >= 0:
                    style = {ON: f"bold {DRACULA['accent']}", PARTIAL: f"bold {NOTE}", OFF: MUTED}[states[column]]
                    style += " italic" if names[column] in BUILT_IN else ""
                out.append(text, f"{style} {cursor}" if on_rig(column) else style)
            out.append("\n")
            for text, column in layout.header():
                if column is not None and column >= 0:
                    mark, style = {ON: ("✓", f"bold {DRACULA['accent']}"), PARTIAL: ("◐", f"bold {NOTE}"),
                                   OFF: ("", "")}[states[column]]
                    out.append(mark.center(len(text)), f"{style} {cursor}" if on_rig(column) else style)
                else:
                    out.append(" " * cells(text))
            out.append("    ")
            out.append_text(legend(states))
            for index, plugin_id in enumerate(layout.rows):
                out.append("\n")
                line = Text()
                loaded = any(p == plugin_id or p.split("@")[0] == plugin_id for p in current.sources)
                for text, column in layout.row(index):
                    if column == -1:
                        style = "" if loaded else MUTED
                    elif column is not None:
                        on = states[column] != OFF and loaded and text.strip() == "●"
                        style = DRACULA["add"] if on else MUTED
                    else:
                        style = ""
                    line.append(text, style)
                if plugin_id in current.missing:
                    line.append("  installs at launch", WARN)
                if index == self.row:
                    line.stylize(cursor)
                out.append_text(line)
            return out

        def measure(self) -> int:
            """The longest line's width: the graph scrolls sideways rather than wrap a row past the window."""
            return max(cells(line) for line in self.render().plain.splitlines())

        def action_move(self, down: int) -> None:
            """Up and down run through the plugins, and up from the first into the rig names."""
            self.row = max(RIGS, min(len(layout.rows) - 1, self.row + down))
            self.reveal()
            self.refresh()

        def action_across(self, step: int) -> None:
            """Left and right move across the rigs, base aside; from a plugin, the first press goes up to them."""
            if self.row == RIGS:
                self.column = max(1, min(len(names) - 1, self.column + step))
            self.row = RIGS
            self.reveal()
            self.refresh()

        def action_cycle(self, step: int) -> None:
            """Tab runs across the rigs as right does, wrapping at either end."""
            if self.row == RIGS:
                self.column = (self.column - 1 + step) % (len(names) - 1) + 1
            self.row = RIGS
            self.reveal()
            self.refresh()

        def reveal(self) -> None:
            if isinstance(self.parent, ScrollableContainer):
                self.parent.scroll_to_region(Region(0, max(self.row + HEADER_LINES - 1, 0), 1, 3), animate=False)

        def action_activate(self) -> None:
            """Space and enter do what a click on what the cursor is on does."""
            if self.row == RIGS:
                self.app.toggle_rig(self.column)
            else:
                self.app.activate(layout.rows[self.row])

        def action_edit(self) -> None:
            current = self.app.current
            self.app.exit((EDIT, current.selected, current.added, current.removed))

        def on_click(self, event) -> None:
            """A click on a rig's name toggles the rig; on a pinned plugin's row it opens the pin, and on any
            other plugin's row toggles the plugin. The cursor moves to what was clicked."""
            offset = event.get_content_offset(self)
            if offset is None:
                return
            column = layout.column_at(offset.x)
            if offset.y < HEADER_LINES and column is not None and column >= 0:
                if column > 0:
                    self.column, self.row = column, RIGS
                self.app.toggle_rig(column)
            elif HEADER_LINES <= offset.y < HEADER_LINES + len(layout.rows):
                self.row = offset.y - HEADER_LINES
                self.app.activate(layout.rows[self.row])
            self.refresh()

    class Rocket(Widget):
        """LAUNCH-13: the launch item at the right end of the footer, a 🚀 trailing exhaust that runs faster
        under the pointer."""

        def __init__(self):
            super().__init__(id="launch")
            self.tick = 0
            self.hot = False

        def on_mount(self) -> None:
            if self.app.animation_level != "none":
                self.set_interval(1 / 8, self.advance)

        def advance(self) -> None:
            self.tick += 2 if self.hot else 1
            self.refresh()

        def on_enter(self) -> None:
            self.hot = True

        def on_leave(self) -> None:
            self.hot = False

        def on_click(self) -> None:
            self.app.action_launch()

        def render(self) -> Text:
            at = self.tick % len(EXHAUST)
            trail = (EXHAUST[at:] + EXHAUST[:at])[:EXHAUST_CELLS]
            return Text.assemble((" l ", "bold"), "Launch ", (trail, DRACULA["background"]), "🚀 ")

    class PinDialog(ModalScreen):
        """PIN-13: one pin's checkout, age, and whether it loads, with Unpin the default, a button that takes
        the plugin out of the launch or puts it in, and one that loads the checkout or skips it; escape or the ✕
        closes it."""

        BINDINGS = [Binding("escape", "close", "Close")]

        def __init__(self, plugin_id: str):
            super().__init__()
            self.plugin_id = plugin_id
            self.offer = self.app.offer(plugin_id)

        def compose(self) -> ComposeResult:
            pin = self.offer.pin
            with Vertical(id="dialog") as dialog:
                dialog.styles.width = max(cells(display(pin["path"])), 40) + 6
                with Horizontal(id="pin-head"):
                    yield Static(Text(f"{PIN} {pin['plugin']}", "bold"), id="pin-title")
                    yield Static("✕", id="pin-close")
                yield Static(self.details(), id="pin-details")
                with Horizontal(id="pin-buttons"):
                    yield Button("Unpin", variant="error", id="unpin")
                    if "@" in self.plugin_id:
                        loaded = self.plugin_id in self.app.current.sources
                        yield Button("Leave out" if loaded else "Load", id="toggle")
                    if not self.offer.locked:
                        checkout = self.app.load(self.offer)
                        yield Button("Skip checkout" if checkout else "Load checkout", id="pin-load")

        def details(self) -> Text:
            app, offer = self.app, self.offer
            loaded = self.plugin_id in app.current.sources
            if offer.locked:
                state = "in these rigs, so the checkout loads"
            elif app.load(offer):
                state = "the checkout loads"
            else:
                state = "the installed copy loads" if loaded else "not loaded"
            return Text.assemble((f"{display(offer.pin['path'])}\n", NOTE),
                                 (f"pinned {age(offer.pin['pinned_at'])}\n", MUTED), state)

        def on_mount(self) -> None:
            self.query_one("#unpin", Button).focus()

        def on_click(self, event) -> None:
            if event.widget is not None and event.widget.id == "pin-close":
                self.dismiss()

        def on_button_pressed(self, event: Button.Pressed) -> None:
            if event.button.id == "toggle":
                self.app.toggle_plugin(self.plugin_id)
            elif event.button.id == "pin-load":
                self.app.toggle_pin(self.plugin_id)
            else:
                self.app.unpin(self.offer.pin)
            self.dismiss()

        def action_close(self) -> None:
            self.dismiss()

    class RigPicker(App):
        TITLE = "rig"
        LAYOUT = layout
        ENABLE_COMMAND_PALETTE = False
        BINDINGS = [Binding("l", "launch", "Launch", show=False), Binding("shift+enter", "launch", show=False),
                    Binding("q", "cancel", "Cancel"), Binding("escape", "cancel", show=False)]
        CSS = f"""
        Screen.picker {{ border: round $border; border-title-align: center; border-title-color: $text; }}
        #summary, #sandbox {{ padding: 0 1; }}
        #scroll {{ height: 1fr; border: round $border; padding: 0 1; }}
        #graph {{ width: auto; height: auto; }}
        #bar {{ dock: bottom; height: 1; }}
        #bar Footer {{ dock: none; width: 1fr; }}
        #launch {{ width: auto; height: 1; background: $footer-background; color: $footer-foreground; }}
        #launch:hover {{ background: {WARN}; }}
        PinDialog {{ align: center middle; }}
        #dialog {{ width: auto; max-width: 90%; height: auto; border: round $border; background: $surface; padding: 1 2; }}
        #pin-head {{ height: 1; margin-bottom: 1; }}
        #pin-title {{ width: 1fr; }}
        #pin-close {{ width: 1; }}
        #pin-close:hover {{ color: {WARN}; }}
        #pin-buttons {{ height: auto; margin-top: 1; align-horizontal: center; }}
        #pin-buttons Button {{ margin: 0 1; }}
        """

        def __init__(self):
            super().__init__()
            use_theme(self)
            self.current = initial
            self.pin_choices: dict[str, bool] = {}

        def compose(self) -> ComposeResult:
            yield Static(id="summary")
            with ScrollableContainer(id="scroll") as scroll:
                scroll.can_focus = False
                scroll.border_subtitle = (f"arrows or tab move  space, enter, or a click toggles a rig or a plugin, "
                                          f"and opens a {PIN}")
                yield Picker()
            yield Static(f"sandbox: {'on' if sandbox else 'off'}", id="sandbox")
            with Horizontal(id="bar"):
                yield Footer()
                yield Rocket()

        def on_mount(self) -> None:
            self.screen.add_class("picker")
            self.screen.border_title = title
            self.show()
            self.query_one(Picker).focus()

        def offer(self, plugin_id: str) -> PinOffer | None:
            return next((o for o in self.current.offered if o.pin["plugin"] == plugin_id.split("@")[0]), None)

        def load(self, offer: PinOffer) -> bool:
            return offer.locked or self.pin_choices.get(offer.pin["path"], offer.selected)

        def show(self) -> None:
            self.query_one("#summary", Static).update(summary(self.current))
            picker = self.query_one(Picker)
            picker.styles.width = picker.measure()
            picker.refresh()

        def say(self, message: str) -> None:
            self.clear_notifications()
            self.notify(message, severity="warning", timeout=4)

        def state(self, column: int) -> str:
            """LAUNCH-11: a rig is partly loaded when plugins of it are taken out, or, not chosen, picked."""
            name, current = names[column], self.current
            plugins = columns[column]["plugins"]
            if name == BASE or name in current.selected:
                return PARTIAL if any(p in current.removed for p in plugins) else ON
            return PARTIAL if name != FULL and any(p in current.added for p in plugins) else OFF

        def toggle_rig(self, column: int) -> None:
            """LAUNCH-09, LAUNCH-11: a rig loaded whole goes, and one partly loaded or not at all comes in whole.
            Every launch loads base, and full holds every other rig's plugins, so full goes alone."""
            name, current = names[column], self.current
            plugins = set(columns[column]["plugins"])
            chosen, added, removed = set(current.selected), list(current.added), list(current.removed)
            if self.state(column) == ON:
                if name == BASE:
                    return
                chosen.discard(name)
                added = [p for p in added if p not in plugins]
            else:
                removed = [p for p in removed if p not in plugins]
                if name == FULL:
                    chosen, added = {FULL}, []
                elif name != BASE:
                    chosen = (chosen - {FULL}) | {name}
            self.current = plan_for([n for n in names if n in chosen], added, removed)
            self.show()

        def toggle_plugin(self, plugin_id: str) -> None:
            """LAUNCH-11: take a plugin out of the launch, or put it in, whatever rigs hold it."""
            current = self.current
            if "@" not in plugin_id:
                self.say(f"{plugin_id} isn't installed; p loads its {PIN}.")
                return
            added, removed = list(current.added), list(current.removed)
            if plugin_id in current.sources:
                if plugin_id in added:
                    added.remove(plugin_id)
                else:
                    removed.append(plugin_id)
            else:
                removed = [p for p in removed if p != plugin_id]
                if plugin_id not in plan_for(current.selected, added, removed).sources:
                    added.append(plugin_id)
            self.current = plan_for(current.selected, added, removed)
            self.show()

        def activate(self, plugin_id: str) -> None:
            """PIN-13, LAUNCH-11: a pinned plugin opens its pin, any other toggles."""
            if self.offer(plugin_id):
                self.push_screen(PinDialog(plugin_id))
            else:
                self.toggle_plugin(plugin_id)

        def unpin(self, pin: dict) -> None:
            """PIN-05, PIN-13: stop loading the checkout, in this launch and the ones after it."""
            write_pins([p for p in read_pins() if p["path"] != pin["path"]])
            pins.remove(pin)
            for index, plugin_id in enumerate(layout.rows):
                layout.labels[index] = plugin_cell(plugin_id, pinned_names(pins))
            self.pin_choices.pop(pin["path"], None)
            current = self.current
            self.current = plan_for(current.selected, current.added, current.removed)
            self.show()
            self.notify(f"unpinned {pin['plugin']} ({display(pin['path'])})", timeout=4)

        def toggle_pin(self, plugin_id: str) -> None:
            offer = self.offer(plugin_id)
            if offer is None:
                self.say(f"{plugin_id} has no {PIN}; rig pin <path> makes one.")
            elif offer.locked:
                self.say(f"{offer.pin['plugin']} is in these rigs, so its {PIN} loads.")
            else:
                self.pin_choices[offer.pin["path"]] = not self.load(offer)
                self.show()

        def action_launch(self) -> None:
            if isinstance(self.screen, PinDialog):
                return
            current = self.current
            self.exit((current.selected, [(offer.pin, self.load(offer)) for offer in current.offered],
                       current.added, current.removed))

        def action_cancel(self) -> None:
            self.exit(None)

    return RigPicker()


def pin_lines(pins: list[tuple[dict, list[str]]]) -> list[str]:
    """PIN-06, PIN-12: one line per pin, `📌 <plugin>  <checkout>  (<age>, <notes>)`, the names lined up."""
    width = max((len(pin["plugin"]) for pin, _ in pins), default=0)
    return [f"{PIN} {pin['plugin'].ljust(width)}  {display(pin['path'])}  ({', '.join([age(pin['pinned_at']), *notes])})"
            for pin, notes in pins]


def describe_pins(chosen: list[tuple[dict, bool]]) -> list[str]:
    """LAUNCH-02: the pins on the launch summary."""
    return pin_lines([(pin, [] if load else ["not loaded"]) for pin, load in chosen]) or [f"{PIN} none"]


def user_settings_file() -> Path:
    return Path.home() / ".claude" / "settings.json"


def enabled_plugins() -> list[str]:
    """SETUP-02: the plugins the user's Claude Code settings enable, in file order."""
    path = user_settings_file()
    if not path.exists():
        return []
    enabled = json.loads(path.read_text()).get("enabledPlugins") or {}
    return [plugin_id for plugin_id, on in enabled.items() if on]


def turn_off_user_plugins() -> list[str]:
    """RIG-12: set each plugin the user's settings enable to false, returning those plugins.

    Edits the text rather than re-serializing, so the file's layout and its blank-line groups (SETUP-04a)
    survive."""
    on = enabled_plugins()
    if not on:
        return []
    path = user_settings_file()
    text = path.read_text()
    block = re.search(r'"enabledPlugins"\s*:\s*\{(.*?)\}', text, re.DOTALL)
    edited = text[:block.start(1)] + re.sub(r'("[^"]+"\s*:\s*)true\b', r"\1false", block.group(1)) + text[block.end(1):]
    left_on = [p for p, value in (json.loads(edited).get("enabledPlugins") or {}).items() if value]
    if left_on:
        fail(f"couldn't turn off {', '.join(left_on)} in {path}; set them to false there, then launch again.")
    path.write_text(edited)
    return on


def listed_groups() -> list[list[str]]:
    """SETUP-04a: the enabledPlugins entries, on or off, as the blank-line groups the settings file shows
    them in.

    Read as text, since a JSON parse drops the blank lines."""
    path = user_settings_file()
    text = path.read_text() if path.exists() else ""
    match = re.search(r'"enabledPlugins"\s*:\s*\{(.*?)\}', text, re.DOTALL)
    if not match:
        return []
    groups, current = [], []
    for line in match.group(1).splitlines():
        entry = re.match(r'\s*"([^"]+)"\s*:\s*(?:true|false)\b', line)
        if entry:
            current.append(entry.group(1))
        elif not line.strip() and current:
            groups.append(current)
            current = []
    return groups + ([current] if current else [])


RIG_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def draft_name(plugins: list[str]) -> str:
    """SETUP-04a: a name for a group of plugins: the plugin's own for one, else the name the plugins start with,
    else their marketplace, else the first plugin's."""
    names = [plugin_id.partition("@")[0] for plugin_id in plugins]
    shared = []
    for words in zip(*(name.split("-") for name in names)):
        if len(set(words)) > 1:
            break
        shared.append(words[0])
    markets = {plugin_id.partition("@")[2] for plugin_id in plugins}
    if len(names) > 1 and not shared and len(markets) == 1 and "" not in markets:
        return markets.pop()
    return "-".join(shared) or names[0]


def suggestions(outside: list[str], groups: list[list[str]]) -> list[tuple[str | None, list[str]]]:
    """SETUP-04a/b: (suggested name, plugins) for each group of plugins outside every rig: the settings
    file's blank-line groups first, then one per marketplace for the plugins those groups leave out."""
    drafts = [(draft_name(kept), kept) for group in groups if (kept := [p for p in group if p in outside])] if len(groups) > 1 else []
    grouped = {plugin_id for _, plugins in drafts for plugin_id in plugins}
    by_market: dict[str, list[str]] = {}
    for plugin_id in outside:
        if plugin_id not in grouped:
            by_market.setdefault(plugin_id.partition("@")[2] or plugin_id, []).append(plugin_id)
    by_name = [(draft_name(plugins) if len(plugins) == 1 else market, plugins) for market, plugins in by_market.items()]
    return drafts + sorted(by_name, key=lambda item: item[0].casefold())


class Refused(Exception):
    """An edit the rig editor won't make; the message says why."""


def plugin_order(plugin_id: str) -> tuple[str, str]:
    return plugin_id.partition("@")[2], plugin_id.partition("@")[0]


class RigEdits:
    """The rig definitions as the rig editor changes them, apart from the screen that shows them."""

    def __init__(self, config: dict | None, enabled: list[str], groups: list[list[str]], installed: list[str], pinned: set[str] = frozenset()):
        self.first_run = config is None or not config["rigs"]
        config = config or {"default": [], "clones": {}, "rigs": {}}
        self.clones = config.get("clones") or {}
        self.rigs = {name: list(rig["plugins"]) for name, rig in config["rigs"].items()}
        self.default = list(config.get("default") or [])
        self.dismissed = list(config.get("dismissed") or [])
        if self.first_run:
            self.rigs = {BASE: list(enabled)}
            self.default = []
        self.enabled = enabled
        self.groups = groups
        self.installed = sorted(installed, key=plugin_order)
        named = {p for plugins in self.rigs.values() for p in plugins}
        self.candidates = sorted(set(installed) | set(enabled) | named, key=plugin_order)
        self.dirty = self.first_run
        self.pinned = set(pinned)

    def order(self) -> list[str]:
        """EDITOR-01: the base rig, the other rigs in alphabetical order, then full."""
        return rig_order(self.rigs)

    def inherited(self, name: str) -> dict[str, str]:
        """EDITOR-04: each plugin the rig gets from the base rig, with the rig that names it."""
        return {} if name in (BASE, FULL) else {plugin_id: BASE for plugin_id in self.rigs[BASE]}

    def drafts(self) -> list[tuple[str | None, list[str]]]:
        """SETUP-04: (suggested name, plugins) for each group of installed plugins that no rig names, on or
        off in the settings."""
        named = {p for plugins in self.rigs.values() for p in plugins} | set(self.dismissed)
        taken = set(self.rigs) | set(BUILT_IN)
        drafts = []
        for suggested, plugins in suggestions([p for p in self.installed if p not in named], self.groups):
            name, count = suggested, 2
            while name in taken:
                name, count = f"{suggested}-{count}", count + 1
            taken.add(name)
            drafts.append((name, plugins))
        return drafts

    def dismiss(self, index: int) -> None:
        """EDITOR-14: stop offering the draft's plugins as a draft."""
        _, plugins = self.drafts()[index]
        self.dismissed += plugins
        self.dirty = True

    def check_name(self, name: str) -> None:
        if not RIG_NAME.fullmatch(name):
            raise Refused("A rig name is letters, digits, '.', '_', or '-', starting with a letter or digit.")
        if name in self.rigs or name == FULL:
            raise Refused(f"There's already a rig named {name}.")

    def fixed(self, name: str, change: str) -> None:
        """EDITOR-07, EDITOR-11: base and full keep their names and can't be deleted."""
        if name == BASE:
            raise Refused(f"{BASE} is the base rig, which every launch loads; it can't be {change}.")
        if name == FULL:
            raise Refused(f"{FULL} is every installed plugin; it can't be {change}.")

    def toggle(self, name: str, plugin_id: str, on: bool) -> None:
        if name == FULL:
            self.fixed(name, "edited")
        plugins = self.rigs[name]
        if on and plugin_id not in plugins:
            plugins.append(plugin_id)
            plugins.sort(key=str.casefold)
        elif not on and plugin_id in plugins:
            plugins.remove(plugin_id)
        self.dirty = True

    def create(self, name: str, plugins: list[str] | None = None) -> None:
        self.check_name(name)
        self.rigs[name] = list(plugins or [])
        self.dirty = True

    def keep_draft(self, index: int, name: str) -> None:
        """SETUP-04: a draft becomes a rig once the user names it."""
        _, plugins = self.drafts()[index]
        self.create(name, plugins)

    def rename(self, name: str, new: str) -> None:
        """EDITOR-11: the rig takes the new name, as does the default."""
        if new == name:
            return
        self.fixed(name, "renamed")
        self.check_name(new)
        self.rigs = {(new if rig == name else rig): plugins for rig, plugins in self.rigs.items()}
        self.default = [new if rig == name else rig for rig in self.default]
        self.dirty = True

    def move_down(self, name: str, plugin_id: str) -> None:
        """EDITOR-13: put a plugin in the selected rig, taking it off the base rig."""
        if name in BUILT_IN:
            raise Refused(f"Select the rig to put {plugin_id} in; > moves a plugin from {BASE} into it.")
        if plugin_id in self.rigs[name]:
            raise Refused(f"{plugin_id} is in {name} already.")
        if plugin_id in self.rigs[BASE]:
            self.rigs[BASE].remove(plugin_id)
        self.toggle(name, plugin_id, True)

    def move_up(self, name: str, plugin_id: str) -> None:
        """EDITOR-13: put a plugin on the base rig, taking it out of the selected rig."""
        if name == FULL:
            raise Refused(f"{FULL} is every installed plugin; select {BASE} or another rig.")
        if plugin_id in self.rigs[BASE]:
            raise Refused(f"{plugin_id} is on {BASE} already.")
        if name != BASE and plugin_id in self.rigs[name]:
            self.rigs[name].remove(plugin_id)
        self.toggle(BASE, plugin_id, True)

    def make_default(self, name: str) -> None:
        """EDITOR-06: add the rig to the ones a launch naming no rig uses, or take it out."""
        if name == BASE:
            raise Refused(f"{BASE} is built in and loads in every launch; d adds other rigs to it.")
        if name in self.default:
            self.default.remove(name)
        else:
            self.default.append(name)
        self.dirty = True

    def delete(self, name: str) -> None:
        """EDITOR-07."""
        self.fixed(name, "deleted")
        del self.rigs[name]
        if name in self.default:
            self.default.remove(name)
        self.dirty = True

    def save(self) -> None:
        """EDITOR-08, SETUP-03: the base rig first, then the rest, each rig's plugins in alphabetical order."""
        order = [name for name in self.order() if name != FULL]
        rigs = {name: {"plugins": sorted(self.rigs[name], key=str.casefold)} for name in order}
        save_config({"default": [name for name in self.order() if name in self.default], "clones": self.clones,
                     "rigs": rigs, "dismissed": sorted(self.dismissed, key=plugin_order)})
        self.dirty = False


def open_edits() -> RigEdits:
    return RigEdits(load_config(), enabled_plugins(), listed_groups(), list(installed_plugins()), pinned_names(read_pins()))


def editor_app(edits: RigEdits):
    """EDITOR-01..12: the rig editor as a Textual app over the edits."""
    from rich.text import Text
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, Vertical
    from textual.screen import ModalScreen, Screen
    from textual.widgets import Button, Footer, Input, Label, SelectionList, Static, Tree
    from textual.widgets.selection_list import Selection

    class RigDialog(ModalScreen):
        """A rig's name; dismisses with the name, or None. `renaming` is the rig's current name, which the new
        name may keep."""

        BINDINGS = [Binding("escape", "cancel", "Cancel")]

        def __init__(self, title: str, name: str | None, renaming: str | None = None):
            super().__init__()
            self.heading, self.suggested, self.renaming = title, name, renaming

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                yield Label(self.heading, id="dialog-title")
                yield Input(value=self.suggested or "", placeholder="rig name", id="name")
                yield Static("", id="dialog-error")
                with Horizontal(id="dialog-buttons"):
                    yield Button("OK", variant="primary", id="ok")
                    yield Button("Cancel", id="cancel")

        def on_input_submitted(self) -> None:
            self.submit()

        def on_button_pressed(self, event: Button.Pressed) -> None:
            if event.button.id == "ok":
                self.submit()
            else:
                self.dismiss(None)

        def action_cancel(self) -> None:
            self.dismiss(None)

        def submit(self) -> None:
            name = self.query_one("#name", Input).value.strip()
            if name != self.renaming:
                try:
                    edits.check_name(name)
                except Refused as refused:
                    self.query_one("#dialog-error", Static).update(str(refused))
                    return
            self.dismiss(name)

    class SaveOnQuit(ModalScreen):
        """EDITOR-09: dismisses with "save", "discard", or None to go back to editing."""

        BINDINGS = [Binding("q", "answer('save')", "Save and quit"), Binding("d", "answer('discard')", "Discard"),
                    Binding("escape", "answer(None)", "Back")]
        AUTO_FOCUS = None

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                yield Label("Save the changes before quitting?", id="dialog-title")
                with Horizontal(id="dialog-buttons"):
                    yield Button("Save (q)", variant="primary", id="save")
                    yield Button("Discard (d)", variant="error", id="discard")

        def on_button_pressed(self, event: Button.Pressed) -> None:
            self.dismiss(event.button.id)

        def action_answer(self, choice: str | None) -> None:
            self.dismiss(choice)

    class PluginList(SelectionList):
        """One box of plugins, naming space in the footer; the arrow keys carry on into the box above or below."""

        BINDINGS = [Binding("space", "select", "Toggle"), Binding("enter", "nothing", show=False)]

        def action_nothing(self) -> None:
            """Enter toggles in a plain SelectionList; here space alone does."""

        def neighbor(self, step: int) -> "PluginList | None":
            boxes = [box for box in self.screen.query(PluginList) if box.display]
            index = boxes.index(self) + step
            return boxes[index] if 0 <= index < len(boxes) else None

        def action_cursor_down(self) -> None:
            below = self.neighbor(1) if self.highlighted == self.option_count - 1 else None
            if below is None or not below.option_count:
                super().action_cursor_down()
                return
            below.focus()
            below.highlighted = 0

        def action_cursor_up(self) -> None:
            above = self.neighbor(-1) if self.highlighted == 0 else None
            if above is None or not above.option_count:
                super().action_cursor_up()
                return
            above.focus()
            above.highlighted = above.option_count - 1

    class RigList(Tree):
        """The rigs pane: a click selects a rig, and a double-click opens it for editing."""

        BINDINGS = [Binding("enter", "nothing", show=False)]

        def on_mount(self) -> None:
            self.auto_expand = False

        def action_nothing(self) -> None:
            """Enter selects in a plain Tree; here the cursor already does."""

    class Editor(Screen):
        BINDINGS = [
            Binding("n", "new_rig", "New rig"),
            Binding("f2", "edit", "Rename"),
            Binding("d", "make_default", "Default"),
            Binding("greater_than_sign", "move_down", "Pull"),
            Binding("less_than_sign", "move_up", "Push"),
            Binding("x", "delete", "Delete"),
            Binding("s", "save", "Save"),
            Binding("q", "leave", "Quit"),
        ]

        def __init__(self):
            super().__init__()
            self.current: tuple[str, str | int] = ("rig", BASE)

        def compose(self) -> ComposeResult:
            if edits.first_run:
                yield Static("First-run setup: tab to base's plugins and untick what not every session needs, "
                             "keep any drafts as rigs, then s to save and q to finish.", id="hint")
            with Horizontal():
                rigs = RigList("rigs", id="rigs")
                rigs.show_root = False
                rigs.border_title = "rigs  ★ default"
                yield rigs
                with Vertical(id="plugin-pane"):
                    yield PluginList(id="base-plugins")
                    yield Static("+", id="plus")
                    yield PluginList(id="plugins")
            yield Footer()

        def say(self, message: str, severity: str = "information") -> None:
            """Show one message at a time, replacing the one before it."""
            self.app.clear_notifications()
            self.app.notify(message, severity=severity, timeout=4)

        def on_mount(self) -> None:
            self.border_title = "rig setup"
            self.rebuild()
            self.query_one("#rigs", Tree).focus()

        def entries(self) -> list[tuple[tuple[str, str | int], Text]]:
            """EDITOR-01: the base rig at the top, the other rigs, the drafts under a suggestions heading, and full at
            the bottom, joined by a bracket down the right."""
            rows: list[tuple[tuple[str, str | int], Text]] = []
            for name in edits.order():
                if name == FULL and (drafts := edits.drafts()):
                    rows.append((("heading", 0), Text("    suggestions", style=f"bold {MUTED}")))
                    for index, (suggested, plugins) in enumerate(drafts):
                        rows.append((("draft", index), Text(f"      {suggested} ({len(plugins)})", style=f"italic {MUTED}")))
                if name in BUILT_IN:
                    text = Text.assemble(("★ " if name in edits.default else "  "), (name, f"italic {FIXED}"),
                                         ("  built-in", MUTED))
                else:
                    text = Text(("  ★ " if name in edits.default else "    ") + name,
                                style="bold" if name in edits.default else "")
                rows.append((("rig", name), text))
            width = max(len(text) for _, text in rows) + 1
            for position, (_, text) in enumerate(rows):
                text.pad_right(width - len(text))
                text.append("┐" if position == 0 else "┘" if position == len(rows) - 1 else "│", style=MUTED)
            return rows

        def rebuild(self, keep: str | None = None) -> None:
            """Redraw both panes from the edits, keeping the cursor on the current rig, and on the plugin `keep`."""
            tree = self.query_one("#rigs", Tree)
            tree.clear()
            for key, text in self.entries():
                tree.root.add_leaf(text, data=key)
            tree.border_subtitle = f"claude launches {label([n for n in edits.order() if n in edits.default])}"
            kind, key = self.current
            if ((kind in ("draft", "heading") and key >= len(edits.drafts()))
                    or (kind == "rig" and key not in edits.order())):
                self.current = ("rig", BASE)
            self.call_after_refresh(self.restore_cursor)
            self.show_plugins(keep)

        def restore_cursor(self) -> None:
            tree = self.query_one("#rigs", Tree)
            for node in tree.root.children:
                if node.data == self.current:
                    tree.move_cursor(node)
                    return

        def show_plugins(self, keep: str | None = None) -> None:
            """EDITOR-04: a rig other than base shows the base rig's plugins in a box of their own, then `+`, then
            its own box."""
            listing = self.query_one("#plugins", SelectionList)
            base_box = self.query_one("#base-plugins", SelectionList)
            highlighted = listing.highlighted
            listing.clear_options()
            base_box.clear_options()
            kind, key = self.current
            split = kind == "rig" and key not in BUILT_IN
            base_box.display = split
            self.query_one("#plus").display = split
            listing.border_subtitle = ""
            if kind == "heading":
                listing.border_title = "suggestions"
                listing.border_subtitle = "select one: s saves it as a rig, x dismisses it"
                listing.add_options([Selection(plugin_cell(p, edits.pinned), p, False, disabled=True)
                                     for _, plugins in edits.drafts() for p in plugins])
                return
            if kind == "draft":
                suggested, plugins = edits.drafts()[key]
                listing.border_title = f"draft: {suggested} (s saves it as a rig, x dismisses it)"
                listing.add_options([Selection(plugin_cell(p, edits.pinned), p, True, disabled=True) for p in plugins])
                return
            if key == FULL:
                listing.border_title = f"{FULL}: {BUILT_IN[FULL]}"
                listing.add_options([Selection(plugin_cell(p, edits.pinned), p, True, disabled=True) for p in edits.installed])
                return
            if key == BASE:
                listing.border_title = f"{BASE}: {BUILT_IN[BASE]}"
                listing.border_subtitle = "space toggles"
                options = [Selection(plugin_cell(p, edits.pinned), p, p in edits.rigs[BASE]) for p in edits.candidates]
            else:
                base_box.border_title = BASE
                base_box.border_subtitle = f"space moves a plugin into {key}"
                base_box.add_options([Selection(plugin_cell(p, edits.pinned), p, True) for p in edits.candidates if p in edits.rigs[BASE]])
                if base_box.option_count:
                    base_box.highlighted = 0
                listing.border_title = key
                listing.border_subtitle = f"space toggles  < moves a plugin onto {BASE}"
                options = [Selection(plugin_cell(p, edits.pinned), p, p in edits.rigs[key]) for p in edits.candidates if p not in edits.rigs[BASE]]
            listing.add_options(options)
            for box in (base_box, listing):
                values = [box.get_option_at_index(i).value for i in range(box.option_count)]
                if keep in values:
                    box.highlighted = values.index(keep)
                    if isinstance(self.focused, SelectionList) and self.focused is not box:
                        box.focus()
                    return
            if options:
                listing.highlighted = min(highlighted or 0, len(options) - 1)

        def on_tree_node_highlighted(self, event: Tree.NodeHighlighted) -> None:
            if event.node.data and event.node.data != self.current:
                self.current = event.node.data
                self.show_plugins()

        def on_selection_list_selection_toggled(self, event: SelectionList.SelectionToggled) -> None:
            kind, key = self.current
            if kind != "rig" or key == FULL or not isinstance(event.selection_list, PluginList):
                return
            plugin_id = event.selection.value
            if event.selection_list.id == "base-plugins":
                edits.move_down(key, plugin_id)
            else:
                edits.toggle(key, plugin_id, plugin_id in event.selection_list.selected)
            self.rebuild(plugin_id)

        def selected_rig(self) -> str | None:
            kind, key = self.current
            if kind != "rig":
                self.say("Select a rig first.", severity="warning")
                return None
            return key

        def attempt(self, change, then: str | None = None) -> None:
            """Make the change, or show why it was refused; `then` is the rig to select after."""
            try:
                change()
            except Refused as refused:
                self.say(str(refused), severity="error")
                return
            if then:
                self.current = ("rig", then)
            self.rebuild()

        def action_new_rig(self) -> None:
            def made(name) -> None:
                if name:
                    self.attempt(lambda: edits.create(name), then=name)

            self.app.push_screen(RigDialog("New rig", None), made)

        def save_draft(self, index: int) -> None:
            """SETUP-04: name the draft, then save it with the rest of the edits."""
            suggested, _ = edits.drafts()[index]

            def kept(name) -> None:
                if name:
                    self.attempt(lambda: edits.keep_draft(index, name), then=name)
                    if name in edits.rigs:
                        self.save()

            self.app.push_screen(RigDialog("Save draft as a rig", suggested), kept)

        def action_edit(self) -> None:
            """EDITOR-10: F2 opens a rig for renaming."""
            kind, key = self.current
            if kind != "rig":
                return
            try:
                edits.fixed(key, "renamed")
            except Refused as refused:
                self.say(str(refused), severity="error")
                return

            def renamed(name) -> None:
                if name:
                    self.attempt(lambda: edits.rename(key, name), then=name)

            self.app.push_screen(RigDialog(f"Rename {key}", key, key), renamed)

        def on_click(self, event) -> None:
            """EDITOR-10: a double-click opens a rig for renaming, or a draft for keeping as a rig."""
            if event.chain == 2 and isinstance(event.widget, RigList):
                self.action_save() if self.current[0] == "draft" else self.action_edit()

        def highlighted_plugin(self) -> str | None:
            listing = self.focused if isinstance(self.focused, PluginList) else self.query_one("#plugins", SelectionList)
            if listing.highlighted is None or self.current[0] != "rig":
                return None
            return listing.get_option_at_index(listing.highlighted).value

        def move(self, change) -> None:
            """EDITOR-13: move the highlighted plugin between the base rig and the selected rig."""
            plugin_id = self.highlighted_plugin()
            if plugin_id is None:
                return
            try:
                change(self.current[1], plugin_id)
            except Refused as refused:
                self.say(str(refused), severity="error")
                return
            self.rebuild(plugin_id)

        def action_move_down(self) -> None:
            self.move(edits.move_down)

        def action_move_up(self) -> None:
            self.move(edits.move_up)

        def action_make_default(self) -> None:
            if (name := self.selected_rig()) is not None:
                self.attempt(lambda: edits.make_default(name))

        def action_delete(self) -> None:
            """EDITOR-07, EDITOR-14: delete the selected rig, or dismiss the selected draft."""
            kind, key = self.current
            if kind == "draft":
                self.attempt(lambda: edits.dismiss(key))
            elif (name := self.selected_rig()) is not None:
                self.attempt(lambda: edits.delete(name), then=BASE)

        def action_save(self) -> None:
            kind, key = self.current
            if kind == "heading":
                self.save()
            elif kind == "draft":
                self.save_draft(key)
            else:
                self.save()

        def save(self) -> None:
            edits.save()
            self.say(f"Saved to {display(rigs_file())}")

        def action_leave(self) -> None:
            if not edits.dirty:
                self.app.exit()
                return

            def chosen(choice: str | None) -> None:
                if choice == "save":
                    edits.save()
                if choice:
                    self.app.exit()

            self.app.push_screen(SaveOnQuit(), chosen)

    class RigEditor(App):
        TITLE = "rig setup"
        ENABLE_COMMAND_PALETTE = False
        CSS = """
        Editor { border: round $border; border-title-align: center; border-title-color: $text; }
        #hint { padding: 0 1; color: $text-muted; }
        #rigs { width: 44; height: 1fr; border: round $border-blurred; }
        #plugin-pane { width: 1fr; height: 1fr; }
        #base-plugins { height: auto; max-height: 50%; border: round $border-blurred; }
        #plus { height: 1; width: 100%; content-align: center middle; color: $text-muted; }
        #plugins { height: 1fr; border: round $border-blurred; }
        #rigs:focus-within, #plugins:focus, #base-plugins:focus { border: round $border; }
        RigDialog, SaveOnQuit { align: center middle; }
        #dialog { width: 60; height: auto; max-height: 80%; border: round $border; background: $surface; padding: 1 2; }
        #dialog-title { text-style: bold; margin-bottom: 1; }
        #dialog-error { color: $error; }
        #dialog-buttons { height: auto; margin-top: 1; }
        #dialog-buttons Button { margin-right: 2; }
        """

        def on_mount(self) -> None:
            use_theme(self)
            self.push_screen(Editor())

    return RigEditor()


def setup() -> None:
    """SETUP-01..05: open the rig editor on the rig definitions, or on a new base rig."""
    editor_app(open_edits()).run()


def save_config(config: dict) -> None:
    data = {"default": config["default"]} if config["default"] else {}
    if config.get("clones"):
        data["clones"] = config["clones"]
    data["rigs"] = {name: {k: v for k, v in rig.items() if v not in ([], None, False)}
                    for name, rig in config["rigs"].items()}
    if config.get("dismissed"):
        data["dismissed"] = config["dismissed"]
    write_yaml(rigs_file(), data)


def cmd_setup(args: list[str]) -> int:
    """SETUP-05."""
    if args:
        fail("setup takes no arguments.")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        fail("setup opens the rig editor, so it needs a terminal.")
    setup()
    return 0


def cmd_complete(args: list[str]) -> int:
    """Values for tab completion that the zsh script can't read off disk itself."""
    if args != ["pinnable"]:
        fail("complete takes: pinnable")
    pinned = {Path(p["path"]) for p in read_pins()}
    clones = clone_roots()
    try:
        names = sorted({plugin["name"] for _, _, plugin in marketplace_plugins()})
    except Unresolved:
        return 0
    for name in names:
        try:
            path = resolve_name(name, clones)
        except Unresolved:
            continue
        if path.resolve() not in pinned:
            print(f"{name}:{display(path)}")
    return 0


WRAPPER = Path.home() / ".local" / "bin" / "rig"
COMPLETION_DIR = Path.home() / ".zsh" / "completions"
SNIPPET = Path.home() / ".zsh" / "rig.zsh"
SNIPPET_SENTINEL = "# rig: claude runs rig"
FPATH_LINE = "fpath=(~/.zsh/completions $fpath)"


def wrapper_text(script: Path) -> str:
    return f'#!/bin/sh\nexec uv run --quiet --script "{script}" "$@"\n'


def is_active(line: str) -> bool:
    return bool(line.strip()) and not line.lstrip().startswith("#")


def make_zsh_dir(path: Path) -> None:
    """Create path and its parents under HOME without group or world write, whatever the umask:
    compinit refuses a completion directory that others can write to."""
    for folder in reversed([path, *path.parents]):
        if folder.is_relative_to(Path.home()) and folder != Path.home() and not folder.exists():
            folder.mkdir(mode=0o755)


def runs_compinit(line: str) -> bool:
    return is_active(line) and re.search(r"\bcompinit\b", line) is not None


def puts_completions_on_fpath(line: str) -> bool:
    return is_active(line) and ".zsh/completions" in line


def install_wrapper() -> None:
    script = (PLUGIN_ROOT / "scripts" / "rig").resolve()
    text = wrapper_text(script)
    if WRAPPER.is_file() and WRAPPER.read_text() == text:
        print(f"  ✓ already installed: {WRAPPER} -> {script}")
    else:
        WRAPPER.parent.mkdir(parents=True, exist_ok=True)
        WRAPPER.write_text(text)
        WRAPPER.chmod(0o755)
        print(f"  ✓ wrote {WRAPPER} -> {script}")
    on_path = {Path(p).expanduser().resolve() for p in os.environ.get("PATH", "").split(os.pathsep) if p}
    if WRAPPER.parent.resolve() not in on_path:
        print(f"  ! {WRAPPER.parent} is not on PATH; add it in ~/.zshrc")


def install_completions() -> None:
    make_zsh_dir(COMPLETION_DIR)
    target = COMPLETION_DIR / "_rig"
    target.write_text(ZSH_COMPLETION)
    print(f"  ✓ wrote {target}")
    zshrc = Path.home() / ".zshrc"
    content = zshrc.read_text() if zshrc.exists() else ""
    lines = content.splitlines(keepends=True)
    if any(puts_completions_on_fpath(line) for line in lines):
        print(f"  ✓ {zshrc} already puts ~/.zsh/completions on fpath")
        return
    at = next((i for i, line in enumerate(lines) if runs_compinit(line)), None)
    if at is None:
        if content and not content.endswith("\n"):
            lines.append("\n")
        lines += [f"{FPATH_LINE}\n", "autoload -Uz compinit && compinit\n"]
        print(f"  ✓ added fpath and compinit to {zshrc}")
    else:
        lines.insert(at, f"{FPATH_LINE}\n")
        print(f"  ✓ added fpath before compinit in {zshrc}")
    zshrc.write_text("".join(lines))


def claude_function_origin() -> str | None:
    """The file that defines a `claude` shell function in a new interactive zsh, or None."""
    result = subprocess.run(["zsh", "-ic", "whence -v claude"], capture_output=True, text=True,
                            stdin=subprocess.DEVNULL)
    last = (result.stdout.strip().splitlines() or [""])[-1]
    match = re.match(r"^claude is a shell function(?: from (.+))?$", last)
    if not match:
        return None
    return match.group(1) or "an unknown file"


SNIPPET_TEXT = f"""{SNIPPET_SENTINEL}: written by `rig install-cli`.
claude() {{ rig claude "$@" }}
# A later compinit drops an earlier compdef, so register at the first prompt.
autoload -Uz add-zsh-hook
_rig_compdef_claude() {{
  compdef _rig claude
  add-zsh-hook -d precmd _rig_compdef_claude
}}
add-zsh-hook precmd _rig_compdef_claude
"""


def install_claude_function() -> None:
    """SHELL-04: make `claude` run rig, unless another shell function already defines claude."""
    origin = claude_function_origin()
    if origin and Path(origin).expanduser() != SNIPPET:
        print(f"  · claude is a shell function from {origin}; left as is")
        return
    make_zsh_dir(SNIPPET.parent)
    SNIPPET.write_text(SNIPPET_TEXT)
    zshrc = Path.home() / ".zshrc"
    content = zshrc.read_text() if zshrc.exists() else ""
    if SNIPPET_SENTINEL in content:
        print(f"  ✓ claude runs rig ({SNIPPET})")
        return
    with zshrc.open("a") as f:
        if content and not content.endswith("\n"):
            f.write("\n")
        f.write(f"source ~/.zsh/rig.zsh  {SNIPPET_SENTINEL}\n")
    print(f"  ✓ claude runs rig from new shells ({SNIPPET}, sourced from {zshrc})")


def cmd_install_cli(args: list[str]) -> int:
    """SHELL-01, SHELL-04."""
    if args:
        fail(f"install-cli takes no arguments, not {' '.join(args)}")
    import shutil
    if not shutil.which("uv"):
        fail("uv is not on PATH; rig runs through it. Install it: https://docs.astral.sh/uv/")
    install_wrapper()
    install_completions()
    install_claude_function()
    print("Open a new shell (or run: exec zsh) to pick up the changes.")
    return 0


def wrapper_target() -> Path | None:
    """The absolute script path the installed wrapper execs, or None without a wrapper."""
    if not WRAPPER.is_file():
        return None
    match = re.search(r'"(/[^"]+)"', WRAPPER.read_text())
    return Path(match.group(1)) if match else None


def in_plugin_cache(path: Path) -> bool:
    parts = path.parts
    return any(parts[i:i + 2] == ("plugins", "cache") for i in range(len(parts) - 1))


def cmd_freshness(args: list[str]) -> int:
    """SHELL-02: report a wrapper that no longer runs this install."""
    target = wrapper_target()
    this_script = (PLUGIN_ROOT / "scripts" / "rig").resolve()
    if target is None or target.resolve() == this_script:
        return 0
    if target.is_file() and not in_plugin_cache(target):
        return 0
    state = "is gone" if not target.is_file() else "is an older install"
    print(json.dumps({
        "systemMessage": f"rig: {INSTALL_COMMAND}  # cli is outdated",
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": (
                f"The rig command at {WRAPPER} runs {target}, which {state}. The loaded plugin is at "
                f"{PLUGIN_ROOT}. {INSTALL_COMMAND} repoints the wrapper; `rig install-cli` from the shell "
                "would run the old copy and keep the old path. The command is the user's to run."),
        },
    }))
    return 0


BADGE_SEPARATOR = " ✦ "


def cmd_badge(args: list[str]) -> int:
    """LAUNCH-14: put the rigs a session launched with on beacon's pane badge, when beacon is installed."""
    import shutil
    rigs = os.environ.get(CURRENT_RIG_ENV, "").split()
    beacon = shutil.which("beacon")
    if not rigs or beacon is None:
        return 0
    try:
        subprocess.run([beacon, "badge", BADGE_SEPARATOR.join(rigs)], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 0


ZSH_COMPLETION = r"""#compdef rig

_rig_help_commands() {
  local cache=$1 tag=$2
  shift 2
  (( ${(P)+cache} )) || typeset -ga $cache
  if (( ! ${(P)#cache} )); then
    local line name listing=0
    local -a found
    for line in ${(f)"$(command claude "$@" --help 2>/dev/null)"}; do
      [[ $line == Commands:* ]] && { listing=1; continue }
      (( listing )) && [[ $line =~ '^  ([a-z][a-z|-]*)( [^ ]+)*  +(.*)$' ]] || continue
      for name in ${(s:|:)match[1]}; do found+=("$name:$match[3]"); done
    done
    set -A $cache $found
  fi
  (( ${(P)#cache} )) && _describe -t commands $tag $cache
}

_rig_names() {
  local file=~/.rig/rigs.yml
  reply=()
  [[ -r $file ]] || return 1
  reply=(${(f)"$(awk '/^rigs:/ { in_rigs = 1; next } /^[^ ]/ { in_rigs = 0 }
    in_rigs && /^  [^ #-][^:]*:/ { sub(/^  /, ""); sub(/:.*/, ""); print }' $file 2>/dev/null)"} full none)
}

_rig_pinned() {
  local file=~/.rig/pins.yml
  [[ -r $file ]] || return 1
  local -a names=(${(f)"$(awk '/^[- ] plugin: / { sub(/^[- ] plugin: /, ""); print }' $file 2>/dev/null)"})
  (( $#names )) && compadd -a names
}

_rig_pinnable() {
  local -a pinnable=(${(f)"$(command rig complete pinnable 2>/dev/null)"})
  (( $#pinnable )) && _describe -t pinnable 'plugin with a local clone' pinnable
}

_rig() {
  local -a commands=(
    'use:Launch Claude Code with the base rig and the named rigs'
    'list:List the rigs with their plugins'
    'setup:Edit the rigs in a full-screen editor'
    'pin:Use a local plugin checkout in place of the installed copy; bare pin lists the pins'
    'unpin:Stop using a pinned checkout'
    'install-cli:Put rig on PATH with completions, and make claude run rig'
    'doctor:Check the rig command, the claude function, and tab completion, then run claude doctor'
  )
  local ret=1
  if [[ $words[2] == rig ]]; then
    words=($words[1] $words[3,-1])
    (( CURRENT-- ))
  elif (( CURRENT == 2 )) && [[ $service == claude ]] && [[ $PREFIX != -* ]]; then
    local -a prefix=('rig:rig commands')
    _describe -t rig-prefix 'rig' prefix && ret=0
  fi
  if (( CURRENT == 2 )); then
    if [[ $PREFIX == -* ]]; then
      local -a flags=('--sandbox:Run Bash in the sandbox, with no unsandboxed commands'
                      '--select:Pick the rigs and pins on the graph before launching'
                      '--help:Show rig help' '--version:Show rig version')
      _describe -t rig-flags 'rig flag' flags && ret=0
    else
      _describe -t rig-commands 'rig command' commands && ret=0
      _rig_help_commands _rig_claude_cmds 'Claude Code command' && ret=0
    fi
    return ret
  fi
  if [[ $words[2] == (plugin|plugins) ]]; then
    if (( CURRENT == 3 )); then
      local -a taken=('pin:Use a local plugin checkout in place of the installed copy (rig)'
                      'unpin:Stop using a pinned checkout (rig)')
      _describe -t rig-commands 'rig command' taken && ret=0
      _rig_help_commands _rig_plugin_cmds 'Claude Code plugin command' plugin && ret=0
      return ret
    fi
    [[ $words[3] == (pin|unpin) ]] && words=($words[1] $words[3,-1]) && (( CURRENT-- ))
  fi
  case $words[2] in
    use)
      _rig_names
      local -a rigs=($reply) named offer
      local word part earlier naming=1
      [[ $PREFIX == *,* ]] && earlier=${PREFIX%,*}
      for word in $words[3,CURRENT-1] $earlier; do
        for part in ${(s:,:)word}; do
          (( ${rigs[(Ie)$part]} )) && named+=($part) || naming=0
        done
      done
      if [[ $PREFIX == -* ]]; then
        compadd -- --sandbox --select
      elif (( naming && $#rigs )); then
        if [[ -n $earlier ]]; then
          IPREFIX+=$earlier,
          PREFIX=${PREFIX##*,}
        fi
        offer=(${${rigs:|named}:#base})
        (( $#named )) && offer=(${offer:#none})
        (( ${named[(Ie)none]} )) && offer=()
        (( $#offer )) && compadd -S ' ' -r ', ' -a offer
      else
        _default
      fi
      ;;
    pin)
      local ret=1
      _rig_pinnable && ret=0
      _directories && ret=0
      return ret
      ;;
    list) compadd -- --json --graph ;;
    unpin) _rig_pinned ;;
    *) _default ;;
  esac
}

_rig "$@"
"""


def cmd_completions(args: list[str]) -> int:
    if args != ["zsh"]:
        fail("completions takes one shell: zsh")
    sys.stdout.write(ZSH_COMPLETION)
    return 0


DOCTOR_PROBE = r"""
typeset -a found=(${^fpath}/_rig(N))
print -r -- "rig-doctor rig=$(whence -p rig)"
print -r -- "rig-doctor claude=$(whence -v claude)"
print -r -- "rig-doctor completer=$found[1]"
print -r -- "rig-doctor compinit=$+functions[compdef]"
print -r -- "rig-doctor comp-rig=$_comps[rig]"
print -r -- "rig-doctor comp-claude=$_comps[claude]"
print -r -- "rig-doctor compdef-pending=$precmd_functions[(I)_rig_compdef_claude]"
"""


def shell_probe() -> dict[str, str] | None:
    """What a new interactive zsh sees, as DOCTOR_PROBE reports it; None when zsh isn't on PATH."""
    import shutil
    if not shutil.which("zsh"):
        return None
    try:
        result = subprocess.run(["zsh", "-ic", DOCTOR_PROBE], capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, timeout=30)
    except subprocess.TimeoutExpired:
        fail("a new interactive zsh didn't finish starting within 30 seconds; check ~/.zshrc.")
    return dict(line.removeprefix("rig-doctor ").split("=", 1)
                for line in result.stdout.splitlines() if line.startswith("rig-doctor "))


def installed_rig_script() -> Path | None:
    """scripts/rig in the rig plugin build installed at user scope, or None."""
    for plugin_id, entries in installed_plugins().items():
        if plugin_id.partition("@")[0] != "rig":
            continue
        for entry in entries:
            if entry.get("scope") == "user" and entry.get("installPath"):
                return Path(entry["installPath"]) / "scripts" / "rig"
    return None


Check = tuple[bool, str, str]
FIX_INSTALL = f"run {INSTALL_COMMAND} in Claude Code"


def same_file(a: Path | str, b: Path) -> bool:
    return Path(a).expanduser().resolve() == b.expanduser().resolve()


def check_rig_on_path(probe: dict[str, str]) -> Check:
    """DOCTOR-01."""
    found = probe.get("rig", "")
    if not found:
        fix = f"add {display(WRAPPER.parent)} to PATH in ~/.zshrc" if WRAPPER.is_file() else FIX_INSTALL
        return False, "a new zsh finds no rig on PATH", fix
    if not same_file(found, WRAPPER):
        return (False, f"rig on PATH is {display(found)}, not {display(WRAPPER)}",
                f"remove {display(found)}, or put {display(WRAPPER.parent)} ahead of it on PATH")
    target = wrapper_target()
    if target is None:
        return False, f"{display(WRAPPER)} doesn't run a rig script", FIX_INSTALL
    if not target.is_file():
        return False, f"rig runs {display(target)}, which is gone", FIX_INSTALL
    if not in_plugin_cache(target):
        return True, f"rig runs the checkout at {display(target.parent.parent)}", ""
    installed = installed_rig_script()
    if installed is None:
        return (False, f"rig runs {display(target)}, but the rig plugin isn't installed",
                f"install rig with /plugin, then {FIX_INSTALL}")
    if not same_file(target, installed):
        return False, f"rig runs {display(target)}, not the installed {display(installed)}", FIX_INSTALL
    return True, f"rig runs the installed plugin at {display(installed.parent.parent)}", ""


def check_claude_runs_rig(probe: dict[str, str]) -> Check:
    """DOCTOR-02."""
    found = probe.get("claude", "")
    match = re.match(r"^claude is a shell function(?: from (.+))?$", found)
    if not match:
        return False, f"in a new zsh, {found or 'claude is not found'}", FIX_INSTALL
    origin = match.group(1)
    if origin is None or not same_file(origin, SNIPPET):
        where = display(origin) if origin else "an unknown file"
        return (False, f"claude is a shell function from {where}",
                f"remove that claude function, then {FIX_INSTALL}")
    if SNIPPET.read_text() != SNIPPET_TEXT:
        return False, f"{display(SNIPPET)} is out of date", FIX_INSTALL
    return True, f"claude runs rig ({display(SNIPPET)})", ""


def check_rig_completion(probe: dict[str, str]) -> Check:
    """DOCTOR-03, for rig."""
    target = COMPLETION_DIR / "_rig"
    if not target.is_file() or target.read_text() != ZSH_COMPLETION:
        state = "out of date" if target.is_file() else "missing"
        return False, f"{display(target)} is {state}", FIX_INSTALL
    found = probe.get("completer", "")
    if not found:
        return False, f"a new zsh doesn't have {display(COMPLETION_DIR)} on fpath", FIX_INSTALL
    if not same_file(found, target):
        return False, f"a new zsh loads _rig from {display(found)} first", f"remove {display(found)}"
    if probe.get("compinit") != "1":
        return False, "compinit didn't run in a new zsh", FIX_INSTALL
    if probe.get("comp-rig") != "_rig":
        return False, "compinit didn't register rig's completion", unregistered_completion_fix()
    return True, "zsh completes rig", ""


def unregistered_completion_fix() -> str:
    """Where ~/.zshrc puts the completions on fpath ahead of compinit, compinit read a dump written
    before _rig existed (as `compinit -C` does, skipping the check for new files)."""
    zshrc = Path.home() / ".zshrc"
    lines = zshrc.read_text().splitlines() if zshrc.is_file() else []
    fpath_at = next((i for i, line in enumerate(lines) if puts_completions_on_fpath(line)), None)
    compinit_at = next((i for i, line in enumerate(lines) if runs_compinit(line)), None)
    if fpath_at is not None and (compinit_at is None or fpath_at < compinit_at):
        return "rm ~/.zcompdump*, then open a new shell; compinit read a dump from before rig's completion"
    return f"put `{FPATH_LINE}` before compinit in ~/.zshrc"


def check_claude_completion(probe: dict[str, str]) -> Check:
    """DOCTOR-03, for claude."""
    if probe.get("comp-claude") == "_rig" or int(probe.get("compdef-pending") or 0) > 0:
        return True, "zsh completes claude as rig", ""
    return False, "zsh doesn't complete claude as rig", FIX_INSTALL


def cmd_doctor(args: list[str]) -> int:
    """DOCTOR-01..05: check what a new zsh sees, then run Claude Code's doctor."""
    probe = shell_probe()
    if probe is None:
        checks = [(False, "zsh isn't on PATH, and rig's shell setup is for zsh", "install zsh")]
    else:
        checks = [check(probe) for check in
                  (check_rig_on_path, check_claude_runs_rig, check_rig_completion, check_claude_completion)]
    print("rig shell setup:")
    for ok, what, fix in checks:
        print(f"  {'✓' if ok else '✗'} {what}")
        if not ok:
            print(f"      fix: {fix}")
    print(flush=True)
    try:
        status = subprocess.run(["claude", "doctor", *args]).returncode
    except FileNotFoundError:
        fail("claude is not on PATH.")
    return 1 if not all(ok for ok, _, _ in checks) else status


USAGE = f"""usage: rig <command> [<args>...]
       rig <claude args>...            launch Claude Code with the default rigs

Commands:
  use <rig>... [<claude args>]
                             launch Claude Code with the base rig and the named rigs,
                             separated by spaces or commas; `full` is every plugin,
                             and `none` stock Claude Code with no plugins (asks first)
  list [--json|--graph]      list the rigs with their plugins; --graph tabulates plugins
                             against rigs
  setup                      edit the rigs in a full-screen editor: their plugins and the
                             default rigs
  pin [<path|name>...]       use a local plugin checkout in place of the installed copy;
                             with no arguments, list the pins
  unpin <path|name>...       stop using a pinned checkout
  install-cli                put rig on PATH with tab completion, and make claude run rig
  doctor                     check the rig command, the claude function, and tab completion
                             in a new zsh, then run Claude Code's doctor

Anything else goes to Claude Code: its subcommands run unchanged, and other
arguments start a session with the default rigs. The install makes `claude` run
`rig claude`, which does the same, and launches the default rigs when given no
arguments. `rig rig <command>` is the same as `rig <command>`.

  --sandbox                  with a launch: run Bash in Claude Code's sandbox without
                             prompting, failing if it's unavailable and allowing no
                             unsandboxed commands
  --select                   with a launch: pick the rigs and pins on the graph first,
                             with the arrow keys, space, p, or the mouse
  -h, --help, help           show this help
  --version                  show rig's version
"""

COMMANDS = {
    "use": cmd_use,
    "list": cmd_list,
    "setup": cmd_setup,
    "pin": cmd_pin,
    "unpin": cmd_unpin,
    "install-cli": cmd_install_cli,
    "doctor": cmd_doctor,
    "completions": cmd_completions,
    "complete": cmd_complete,
    "freshness": cmd_freshness,
    "badge": cmd_badge,
    "switch": cmd_switch,
}
UNCOMPLETED_COMMANDS = {"completions", "complete", "freshness", "badge", "switch"}
CLAUDE_SUBCOMMANDS_TAKEN = {"plugin": ("pin", "unpin"), "plugins": ("pin", "unpin")}


def bare() -> int:
    """SHELL-05: `rig` alone opens first-run setup when no rigs are defined and someone is at a terminal,
    and prints the usage otherwise."""
    config = load_config()
    if (config is None or not config["rigs"]) and sys.stdin.isatty() and sys.stdout.isatty():
        setup()
        return 0
    print(USAGE, end="")
    return 0


def main(argv: list[str]) -> int:
    as_claude = argv[:1] == ["claude"]
    if as_claude:
        argv = argv[1:]
    if argv[:1] == ["rig"]:
        argv = argv[1:]
        as_claude = False
    elif argv[:1] and argv[1:2] and argv[1] in CLAUDE_SUBCOMMANDS_TAKEN.get(argv[0], ()):
        argv = argv[1:]
    if not argv and not as_claude:
        return bare()
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(USAGE, end="")
        return 0
    if argv[:1] == ["--version"]:
        print(f"rig {version_display()}")
        return 0
    if argv and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:])
    if argv and not argv[0].startswith("-") and argv[0] in claude_subcommands():
        exec_claude(argv)
    launch(None, argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

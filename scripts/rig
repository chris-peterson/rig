#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml", "textual"]
# ///
"""Launch Claude Code with a named set of plugins (a rig)."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

PROG = "rig"
PKG_ROOT = Path(__file__).resolve().parent.parent
PLUGIN_ROOT = Path(os.environ.get("CLAUDE_PLUGIN_ROOT") or PKG_ROOT)
INSTALL_COMMAND = "/rig:install-rig"


def rig_home() -> Path:
    return Path.home() / ".rig"


def fail(message: str) -> None:
    sys.exit(f"{PROG}: {message}")


def plugin_version() -> str:
    return json.loads((PLUGIN_ROOT / ".claude-plugin" / "plugin.json").read_text())["version"]


def git_read(*args: str) -> str:
    result = subprocess.run(["git", "-C", str(PKG_ROOT), *args], capture_output=True, text=True,
                            env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    return result.stdout.strip() if result.returncode == 0 else ""


def version_display() -> str:
    """The manifest version, marked as a prerelease when this copy is a git checkout."""
    version = plugin_version()
    if not (PKG_ROOT / ".git").exists():
        return version
    sha = git_read("rev-parse", "--short=7", "HEAD")
    if not sha:
        return f"{version}-dev"
    dirty = ".dirty" if git_read("status", "--porcelain") else ""
    return f"{version}-dev.g{sha}{dirty}"


def claude_subcommands() -> set[str]:
    """The subcommand names `claude --help` lists, aliases included (`plugin|plugins`)."""
    result = subprocess.run(["claude", "--help"], capture_output=True, text=True)
    if result.returncode != 0:
        fail(f"`claude --help` failed ({result.returncode}): {result.stderr.strip()}")
    names, listing = set(), False
    for line in result.stdout.splitlines():
        if line.startswith("Commands:"):
            listing = True
            continue
        match = listing and re.match(r"^  ([a-z][a-z|-]*)(?: |$)", line)
        if match:
            names.update(match.group(1).split("|"))
    return names


def exec_claude(args: list[str]) -> None:
    try:
        os.execvp("claude", ["claude", *args])
    except FileNotFoundError:
        fail("claude is not on PATH.")


def interactive(args: list[str]) -> bool:
    """A person at a terminal starting a session they will type into."""
    return sys.stdin.isatty() and sys.stderr.isatty() and not {"-p", "--print"} & set(args)


def yaml_module():
    try:
        import yaml
    except ImportError:
        fail("PyYAML is missing. Run rig through uv (`uv run --script`), as the installed wrapper does.")
    return yaml


def read_yaml(path: Path):
    yaml = yaml_module()
    try:
        return yaml.safe_load(path.read_text())
    except yaml.YAMLError as error:
        fail(f"{path} is not valid YAML: {error}")


def write_yaml(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(yaml_module().safe_dump(data, sort_keys=False, default_flow_style=False))


def rigs_file() -> Path:
    return rig_home() / "rigs.yml"


def load_config() -> dict | None:
    """rigs.yml as {default, clones, rigs}, checked for shape; None when there is no file."""
    path = rigs_file()
    if not path.exists():
        return None
    data = read_yaml(path) or {}
    if not isinstance(data, dict):
        fail(f"{path} should hold a mapping with default, clones, and rigs.")
    rigs = data.setdefault("rigs", {}) or {}
    data["rigs"] = rigs
    data["clones"] = data.get("clones") or {}
    for name, rig in rigs.items():
        if rig is None:
            rig = rigs[name] = {}
        if not isinstance(rig, dict):
            fail(f"rig {name} in {path} should be a mapping with plugins and extends.")
        unknown = sorted(set(rig) - {"plugins", "extends"})
        if unknown:
            fail(f"rig {name} in {path}: a rig has plugins and extends, not {', '.join(unknown)}.")
        rig["plugins"] = rig.get("plugins") or []
        if not isinstance(rig["plugins"], list) or not all(isinstance(v, str) for v in rig["plugins"]):
            fail(f"rig {name} in {path}: plugins should be a list of names.")
        parent = rig.get("extends")
        if parent is not None and not isinstance(parent, str):
            fail(f"rig {name} in {path} extends more than one rig; a rig extends one, like `extends: base`.")
        if parent is not None and parent not in rigs:
            fail(f"rig {name} extends {parent}, which {path} doesn't define.")
        rig["extends"] = parent
    roots = [name for name, rig in rigs.items() if rig["extends"] is None]
    if len(roots) > 1:
        fail(f"rigs {', '.join(roots)} in {path} extend no other rig, and only the base rig may. "
             "Make the others extend it.")
    default = data.get("default")
    if default is not None and default not in rigs:
        fail(f"the default rig in {path} is {default}, which isn't defined there.")
    return data


def resolve(name: str, rigs: dict, path: tuple[str, ...] = ()) -> list[str]:
    """RIG-02, RIG-03: the plugins a rig loads, its own after those of the rigs it extends, without repeats."""
    if name in path:
        cycle = path[path.index(name):] + (name,)
        fail(f"rigs {' → '.join(cycle)} extend each other in a cycle; launch refused.")
    parent = rigs[name]["extends"]
    plugins = resolve(parent, rigs, path + (name,)) if parent else []
    return list(dict.fromkeys(plugins + rigs[name]["plugins"]))


SANDBOX_SETTINGS = {"enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False}


def take_sandbox_flag(args: list[str]) -> tuple[bool, list[str]]:
    """SANDBOX-01: whether --sandbox appears before any `--`, and the arguments without it."""
    end = args.index("--") if "--" in args else len(args)
    head = [a for a in args[:end] if a != "--sandbox"]
    return len(head) < end, head + args[end:]


def settings_files(cwd: Path) -> list[Path]:
    """Claude Code settings files that can enable plugins for a session in cwd."""
    files = [Path.home() / ".claude" / "settings.json"]
    for folder in (cwd, *cwd.parents):
        files += [folder / ".claude" / "settings.json", folder / ".claude" / "settings.local.json"]
    return list(dict.fromkeys(f for f in files if f.is_file()))


def installed_plugins() -> dict:
    path = Path.home() / ".claude" / "plugins" / "installed_plugins.json"
    return json.loads(path.read_text()).get("plugins", {}) if path.exists() else {}


def installed_for(cwd: Path) -> set[str]:
    """Plugin ids installed at user scope, or at a project scope that covers cwd."""
    ids = set()
    for plugin_id, entries in installed_plugins().items():
        for entry in entries:
            project = entry.get("projectPath")
            if entry.get("scope") == "user" or (project and cwd.is_relative_to(Path(project).resolve())):
                ids.add(plugin_id)
    return ids


def known_plugin_ids(cwd: Path) -> set[str]:
    """Every plugin id a session in cwd could load: each one installed, and each one any settings file names."""
    ids = set(installed_plugins())
    for path in settings_files(cwd):
        try:
            ids.update((json.loads(path.read_text()).get("enabledPlugins") or {}).keys())
        except json.JSONDecodeError as error:
            fail(f"{path} is not valid JSON: {error}")
    return ids


def overlay(rig_ids: list[str], pinned: set[str], known: set[str], sandbox: bool) -> dict:
    """RIG-04, PIN-08, SANDBOX-01: settings that enable the rig's plugins, turn off the installed copy of each
    loaded pin, and turn on the sandbox with no unsandboxed commands when asked.

    Every other plugin is left to the settings files, since a --settings value outranks them all and would
    keep a plugin enabled mid-session from loading."""
    enabled = {plugin_id: False for plugin_id in sorted(known) if plugin_id.split("@")[0] in pinned}
    enabled.update({plugin_id: True for plugin_id in rig_ids})
    return {"enabledPlugins": enabled, **({"sandbox": SANDBOX_SETTINGS} if sandbox else {})}


def install(plugins: list[str]) -> None:
    """RIG-08: install the plugins the user confirmed the launch with."""
    for plugin in plugins:
        if subprocess.run(["claude", "plugin", "install", plugin]).returncode != 0:
            fail(f"`claude plugin install {plugin}` failed; launch refused.")


AUTO_MODE_SERVER = "CLAUDE_CODE_AUTO_MODE_SERVER"


def auto_mode_server_off(loaded: list[dict], cwd: Path) -> list[str]:
    """PIN-11: the launch-summary line when this launch turns the auto mode server off, else nothing."""
    cwd = cwd.resolve()
    here = [pin["plugin"] for pin in loaded
            if cwd.is_relative_to(Path(pin["path"]).resolve()) or Path(pin["path"]).resolve().is_relative_to(cwd)]
    if not here or AUTO_MODE_SERVER in os.environ:
        return []
    # Auto mode refuses edits inside a --plugin-dir checkout under the session's folder:
    # https://github.com/anthropics/claude-code/issues/95982
    os.environ[AUTO_MODE_SERVER] = "0"
    return [f"auto mode: {AUTO_MODE_SERVER}=0, since {', '.join(here)} {'is' if len(here) == 1 else 'are'} pinned here"]


def settings_flag(args: list[str]) -> bool:
    return any(a == "--settings" or a.startswith("--settings=") for a in args)


def launch(name: str | None, args: list[str]) -> None:
    """RIG-06, LAUNCH-06, SANDBOX-01, SETUP-01, SETUP-06: launch a rig; at a terminal, stay Claude Code's
    parent so a switch can relaunch the conversation under another rig."""
    sandbox_flag, args = take_sandbox_flag(args)
    if settings_flag(args):
        fail("rig starts Claude Code with its own --settings, and a second --settings replaces the first. "
             "Put these settings in ~/.claude/settings.json or the project's .claude/settings.json.")
    config = load_config()
    if config is None or not config["rigs"]:
        if not interactive(args):
            fail("no rigs are defined, and setup needs a terminal; run `rig setup`.")
        setup()
        config = load_config()
        if config is None or not config["rigs"]:
            fail("setup closed without saving any rigs; launch stopped. Run `rig setup` to try again.")
    if name is None:
        name = config.get("default")
        if name is None:
            fail(f"{rigs_file()} names no default rig; run `rig setup`, or launch one with `rig use <name>`.")
    if not interactive(args):
        exec_claude(claude_args(name, args, sandbox_flag))
    request = switch_file()
    try:
        while True:
            status = run_claude(claude_args(name, args, sandbox_flag),
                                {SWITCH_ENV: str(request), CURRENT_RIG_ENV: name})
            switch = take_switch(request)
            if switch is None:
                raise SystemExit(status)
            name, args = switch["rig"], ["--resume", switch["session"]]
            print(f"{PROG}: switching to rig {name}, resuming this conversation", file=sys.stderr)
    finally:
        request.unlink(missing_ok=True)


def claude_args(name: str, args: list[str], sandbox_flag: bool) -> list[str]:
    """RIG-04, RIG-05, RIG-08, RIG-09, RIG-12, PIN-10, LAUNCH-01..02, LAUNCH-05: the arguments that start Claude Code
    with the rig, once its plugins are installed and its pins chosen."""
    rigs = load_config()["rigs"]
    if name not in rigs:
        fail(f"no rig named {name}. Rigs: {', '.join(rigs)}")
    cwd = Path.cwd()
    plugins = resolve(name, rigs)
    missing = [p for p in plugins if p not in installed_for(cwd)]
    offered = pin_offers(plugins, cwd)
    lineage = f" (extends {rigs[name]['extends']})" if rigs[name]["extends"] else ""
    count = f"{len(plugins)} plugin{'' if len(plugins) == 1 else 's'}"
    heading = f"rig: {name}{lineage}, {count}"
    if not interactive(args):
        if missing:
            fail(f"rig {name} names plugins that aren't installed: {', '.join(missing)}. "
                 "Install them with `claude plugin install <plugin>`, or launch at a terminal to be asked.")
        chosen = [(offer.pin, offer.in_rig) for offer in offered]
    elif missing or any(not offer.locked for offer in offered):
        chosen = launch_app(name, rigs[name]["extends"], plugin_sources(name, rigs), missing, offered,
                            sandbox_flag).run()
        if chosen is None:
            fail("launch cancelled.")
    else:
        chosen = [(offer.pin, True) for offer in offered]
    install(missing)
    turned_off = [p for p in turn_off_user_plugins() if p not in plugins]
    loaded = [pin for pin, load in chosen if load]
    replaced = {pin["plugin"] for pin in loaded}
    enabled = [p for p in plugins if p.split("@")[0] not in replaced]
    stray = [f"turned off in {display(user_settings_file())}: {', '.join(turned_off)}"] if turned_off else []
    print(heading, *describe_pins(chosen), *stray, *auto_mode_server_off(loaded, cwd),
          f"sandbox: {'on' if sandbox_flag else 'off'}", sep="\n", file=sys.stderr)
    plugin_dirs = [arg for pin in loaded for arg in ("--plugin-dir", pin["path"])]
    settings = overlay(enabled, replaced, known_plugin_ids(cwd), sandbox_flag)
    return ["--settings", json.dumps(settings), *plugin_dirs, *args]


SWITCH_ENV = "RIG_SWITCH_FILE"
CURRENT_RIG_ENV = "RIG_CURRENT"


def switch_file() -> Path:
    """Where a session this rig process launched records a switch: one file per rig process."""
    return rig_home() / "switch" / f"{os.getpid()}.yml"


def take_switch(path: Path) -> dict | None:
    """SWITCH-02: the switch a session recorded before it exited, removed once read."""
    if not path.exists():
        return None
    switch = read_yaml(path)
    path.unlink()
    return switch


def run_claude(args: list[str], env: dict[str, str]) -> int:
    """LAUNCH-06: run Claude Code as a child, leaving Ctrl-C to it, and return its exit status.

    The handlers are Python functions rather than SIG_IGN, since an ignored signal stays ignored across exec."""
    import signal
    try:
        child = subprocess.Popen(["claude", *args], env={**os.environ, **env})
    except FileNotFoundError:
        fail("claude is not on PATH.")
    forward = lambda signum, _frame: child.send_signal(signum)
    previous = {sig: signal.signal(sig, handler) for sig, handler in (
        (signal.SIGINT, lambda *_: None), (signal.SIGQUIT, lambda *_: None),
        (signal.SIGTERM, forward), (signal.SIGHUP, forward))}
    try:
        status = child.wait()
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
    return 128 - status if status < 0 else status


def cmd_switch(args: list[str]) -> int:
    """SWITCH-01, SWITCH-03..05: record the rig a session switches to once Claude Code exits."""
    session = None
    if "--session" in args:
        at = args.index("--session")
        session = args[at + 1] if at + 1 < len(args) else None
        args = args[:at] + args[at + 2:]
    if not session or len(args) > 1:
        fail("switch takes a rig name and the session id: rig switch [<rig>] --session <id>")
    config = load_config()
    rigs = config["rigs"] if config else {}
    current = os.environ.get(CURRENT_RIG_ENV)
    if not args:
        for name in rigs:
            print(f"{name}{' (this session)' if name == current else ''}")
        return 0
    name = args[0]
    if name not in rigs:
        fail(f"no rig named {name}. Rigs: {', '.join(rigs) or 'none'}")
    request = os.environ.get(SWITCH_ENV)
    if not request:
        fail(f"this session wasn't launched by rig at a terminal, so rig can't relaunch it. Exit Claude Code, "
             f"then run: rig use {name} --resume {session}")
    if name == current:
        print(f"{PROG}: this session already uses rig {name}.")
        return 0
    write_yaml(Path(request), {"rig": name, "session": session})
    print(f"{PROG}: exit Claude Code (/exit), and rig relaunches this conversation with rig {name}.")
    return 0


def cmd_use(args: list[str]) -> int:
    if not args or args[0].startswith("-"):
        fail("use takes a rig name: rig use <name> [claude args...]")
    launch(args[0], args[1:])


def cmd_list(args: list[str]) -> int:
    """RIG-07."""
    if args:
        fail("list takes no arguments.")
    config = load_config()
    if config is None or not config["rigs"]:
        print("No rigs defined. Run: rig setup")
        return 0
    for name, rig in config["rigs"].items():
        print(f"{name}{' (default)' if name == config.get('default') else ''}")
        if rig["extends"]:
            print(f"  extends: {rig['extends']}")
        print(f"  plugins: {', '.join(rig['plugins']) or 'none'}")
    return 0


def pins_file() -> Path:
    return rig_home() / "pins.yml"


def read_pins() -> list[dict]:
    """Each pin as {path, plugin, pinned_at}, in path order."""
    path = pins_file()
    entries = (read_yaml(path) or []) if path.exists() else []
    if not isinstance(entries, list):
        fail(f"{path} should hold a list of pins.")
    return sorted(entries, key=lambda e: str(e["path"]).casefold())


def write_pins(pins: list[dict]) -> None:
    write_yaml(pins_file(), sorted(pins, key=lambda e: str(e["path"]).casefold()))


def display(path: Path | str) -> str:
    path = Path(path)
    for home in (Path.home(), Path.home().resolve()):
        if path.is_relative_to(home):
            return f"~/{path.relative_to(home)}"
    return str(path)


AGE_UNITS = (("year", 365 * 86400), ("month", 30 * 86400), ("week", 7 * 86400),
             ("day", 86400), ("hour", 3600), ("minute", 60))


def age(pinned_at: str) -> str:
    """How long ago, in the largest whole unit: "3 days ago"."""
    from datetime import datetime, timezone
    seconds = (datetime.now(timezone.utc) - datetime.fromisoformat(pinned_at)).total_seconds()
    for unit, size in AGE_UNITS:
        if seconds >= size:
            count = int(seconds // size)
            return f"{count} {unit}{'' if count == 1 else 's'} ago"
    return "just now"


def manifest_name(path: Path) -> str | None:
    manifest = path / ".claude-plugin" / "plugin.json"
    return json.loads(manifest.read_text()).get("name") if manifest.is_file() else None


class Unresolved(Exception):
    """A plugin name that doesn't map to one local clone; the message says why."""


def repo_key(url: str) -> tuple[str, str]:
    """(host, repo path) for an https or scp-style git URL."""
    match = re.match(r"^(?:https?://|ssh://)?(?:[^@/]+@)?([^/:]+)[:/](.+?)(?:\.git)?/?$", url)
    if not match:
        raise Unresolved(f"can't read a host and repo path from {url}")
    return match.group(1), match.group(2)


def marketplace_plugins() -> list[tuple[str, dict, dict]]:
    """(marketplace, its known_marketplaces.json entry, plugin entry) for every plugin a known marketplace lists."""
    known = Path.home() / ".claude" / "plugins" / "known_marketplaces.json"
    if not known.exists():
        raise Unresolved(f"{known} does not exist, so plugin names can't be looked up. Pass a path.")
    plugins = []
    for market, entry in json.loads(known.read_text()).items():
        location = Path(entry["installLocation"])
        manifest = location if location.is_file() else location / ".claude-plugin" / "marketplace.json"
        if not manifest.is_file():
            raise Unresolved(f"marketplace {market} has no manifest at {manifest}")
        plugins += [(market, entry, plugin) for plugin in json.loads(manifest.read_text()).get("plugins", [])]
    return plugins


def marketplace_sources(name: str) -> list[tuple[str, str]]:
    """(git URL, path within the repo) for each known marketplace entry named <name>."""
    sources = []
    for market, entry, plugin in marketplace_plugins():
        if plugin.get("name") != name:
            continue
        source = plugin["source"]
        if isinstance(source, str):
            source, subdir = entry["source"], source
        else:
            subdir = source.get("path", "")
        if source["source"] == "github":
            url = f"https://github.com/{source['repo']}.git"
        elif source["source"] in ("url", "git-subdir", "git"):
            url = source["url"]
        else:
            raise Unresolved(f"{name} in {market} comes from a {source['source']} source; pass a path.")
        sources.append((url, subdir.removeprefix("./")))
    return sources


def origin_url(clone: Path) -> str:
    return subprocess.run(["git", "-C", str(clone), "remote", "get-url", "origin"],
                          capture_output=True, text=True).stdout.strip()


def resolve_name(name: str, clones: dict[str, Path]) -> Path:
    """PIN-02: the local clone of the plugin's marketplace source repo."""
    sources = marketplace_sources(name)
    if not sources:
        raise Unresolved(f"no known marketplace lists a plugin named {name}, and ./{name} doesn't exist. Pass a path.")
    candidates = {}
    for url, subdir in sources:
        host, repo = repo_key(url)
        if host not in clones:
            raise Unresolved(f"{name} comes from {url}, and {rigs_file()} names no clone folder for {host} "
                             f"under clones. Add `{host}: <folder holding your {host} clones>` there, or pass a path.")
        clone = clones[host] / repo
        if not clone.is_dir():
            raise Unresolved(f"{name} comes from {url}, which isn't cloned at {clone}. Clone it there or pass a path.")
        origin = origin_url(clone)
        if not origin or repo_key(origin) != (host, repo):
            raise Unresolved(f"{clone} has origin {origin or 'unset'}, not {url}.")
        candidates[clone / subdir if subdir else clone] = url
    if len(candidates) > 1:
        raise Unresolved(f"{name} resolves to {len(candidates)} checkouts; pass one: "
                         + ", ".join(map(str, candidates)))
    return next(iter(candidates))


def clone_roots() -> dict[str, Path]:
    config = load_config()
    return {host: Path(folder).expanduser() for host, folder in (config or {}).get("clones", {}).items()}


def show_pins() -> int:
    """PIN-06."""
    pins = read_pins()
    if not pins:
        print("No plugins pinned.")
        return 0
    width = max(len(p["plugin"]) for p in pins)
    for pin in pins:
        notes = [f"pinned {age(pin['pinned_at'])}"] + ([] if Path(pin["path"]).is_dir() else ["missing"])
        print(f"{pin['plugin'].ljust(width)}  {display(pin['path'])}  ({', '.join(notes)})")
    return 0


def cmd_pin(args: list[str]) -> int:
    """PIN-01..03, PIN-06."""
    if not args:
        return show_pins()
    from datetime import datetime, timezone
    pins = read_pins()
    for arg in args:
        path = Path(arg).expanduser().resolve()
        if not path.exists():
            if "/" in arg:
                fail(f"{path} does not exist.")
            try:
                path = resolve_name(arg, clone_roots()).resolve()
            except Unresolved as unresolved:
                fail(str(unresolved))
        name = manifest_name(path)
        if name is None:
            fail(f"{path} holds no plugin manifest (.claude-plugin/plugin.json); pin refused.")
        same = next((p for p in pins if p["plugin"] == name), None)
        if same and Path(same["path"]) == path:
            print(f"{PROG}: {name} is already pinned at {display(path)}")
            continue
        if same:
            fail(f"{name} is already pinned at {display(same['path'])}. Unpin it first: rig unpin {name}")
        pins.append({"path": str(path), "plugin": name,
                     "pinned_at": datetime.now(timezone.utc).isoformat(timespec="seconds")})
        print(f"{PROG}: pinned {name} at {display(path)}")
    write_pins(pins)
    return 0


def cmd_unpin(args: list[str]) -> int:
    """PIN-05."""
    if not args:
        fail("unpin takes a pinned path or plugin name: rig unpin <path|name>")
    pins = read_pins()
    for arg in args:
        path = Path(arg).expanduser().resolve()
        matches = [p for p in pins if Path(p["path"]) == path or p["plugin"] == arg or Path(p["path"]).name == arg]
        if not matches:
            fail(f"{arg} is not pinned. Pinned: {', '.join(p['plugin'] for p in pins) or 'none'}")
        if len(matches) > 1:
            fail(f"{arg} matches {len(matches)} pins; pass the path: " + ", ".join(p["path"] for p in matches))
        pins.remove(matches[0])
        print(f"{PROG}: unpinned {matches[0]['plugin']} ({display(matches[0]['path'])})")
    write_pins(pins)
    return 0


class PinOffer(NamedTuple):
    pin: dict
    in_rig: bool
    here: bool

    @property
    def selected(self) -> bool:
        """PIN-07..09: selected on the launch confirmation when the rig includes it or the launch starts inside it."""
        return self.in_rig or self.here

    @property
    def locked(self) -> bool:
        """PIN-08: a pin the rig includes loads, unless the launch starts inside it."""
        return self.in_rig and not self.here


def pin_offers(plugins: list[str], cwd: Path) -> list[PinOffer]:
    """PIN-04: each pin as the launch offers it, stopping the launch on a pin whose checkout is gone."""
    pins = read_pins()
    for pin in pins:
        if not Path(pin["path"]).is_dir():
            fail(f"pinned plugin {pin['plugin']} is missing at {display(pin['path'])}. "
                 f"Unpin it: rig unpin {pin['plugin']}")
    in_rig = {plugin_id.split("@")[0] for plugin_id in plugins}
    return [PinOffer(pin, pin["plugin"] in in_rig, cwd.is_relative_to(Path(pin["path"]))) for pin in pins]


def plugin_sources(name: str, rigs: dict) -> dict[str, str]:
    """Each plugin the rig loads, in load order, with the rig that names it."""
    chain = [name]
    while rigs[chain[-1]]["extends"]:
        chain.append(rigs[chain[-1]]["extends"])
    sources: dict[str, str] = {}
    for rig in reversed(chain):
        for plugin_id in rigs[rig]["plugins"]:
            sources.setdefault(plugin_id, rig)
    return sources


def launch_app(name: str, extends: str | None, sources: dict[str, str], missing: list[str],
               offered: list[PinOffer], sandbox: bool):
    """LAUNCH-05: the rig, read-only, then the pins it leaves open; exits with each pin and whether to load
    it, or None when cancelled."""
    from rich.text import Text
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import VerticalScroll
    from textual.widgets import Footer, SelectionList, Static
    from textual.widgets.selection_list import Selection

    pinned = {offer.pin["plugin"]: offer for offer in offered if offer.in_rig}
    open_pins = [(index, offer) for index, offer in enumerate(offered) if not offer.locked]

    def plugin_line(plugin_id: str) -> Text:
        line = Text(plugin_id)
        if sources[plugin_id] != name:
            line.append(f"  from {sources[plugin_id]}", "dim")
        offer = pinned.get(plugin_id.split("@")[0])
        if offer and offer.locked:
            line.append(f"  pinned at {display(offer.pin['path'])}", "cyan")
        elif offer:
            line.append("  pinned here; choose below", "cyan")
        if plugin_id in missing:
            line.append("  not installed; installs at launch", "yellow")
        return line

    def pin_option(index: int, offer: PinOffer) -> Selection:
        label = Text.assemble(offer.pin["plugin"], f"  {display(offer.pin['path'])}")
        if offer.in_rig:
            label.append("  holds this folder; unselected, the installed copy loads", "dim")
        elif offer.here:
            label.append("  holds this folder", "dim")
        return Selection(label, index, offer.selected)

    class LaunchConfirmation(App):
        TITLE = "rig"
        BINDINGS = [Binding("enter", "launch", "Launch", priority=True),
                    Binding("escape,q", "cancel", "Cancel")]
        CSS = """
        #rig { height: auto; max-height: 60%; border: round $primary; padding: 0 1; }
        #pins { height: auto; max-height: 1fr; border: round $accent; }
        #sandbox { padding: 0 1; }
        """

        def compose(self) -> ComposeResult:
            with VerticalScroll(id="rig") as rig:
                rig.border_title = f"rig {name}" + (f" (extends {extends})" if extends else " (the base rig)")
                rig.can_focus = False
                yield Static(Text("\n").join(plugin_line(p) for p in sources) or Text("no plugins", "dim"))
            if open_pins:
                pins = SelectionList(*(pin_option(index, offer) for index, offer in open_pins), id="pins")
                pins.border_title = "pins to load (space toggles)"
                yield pins
            yield Static(f"sandbox: {'on' if sandbox else 'off'}", id="sandbox")
            yield Footer()

        def action_launch(self) -> None:
            selected = set(self.query_one("#pins", SelectionList).selected) if open_pins else set()
            self.exit([(offer.pin, offer.locked or index in selected) for index, offer in enumerate(offered)])

        def action_cancel(self) -> None:
            self.exit(None)

    return LaunchConfirmation()


def describe_pins(chosen: list[tuple[dict, bool]]) -> list[str]:
    if not chosen:
        return ["pins: none"]
    width = max(len(pin["plugin"]) for pin, _ in chosen)
    lines = []
    for pin, load in chosen:
        note = f"pinned {age(pin['pinned_at'])}" + ("" if load else ", not loaded")
        lines.append(f"{pin['plugin'].ljust(width)}  {display(pin['path'])}  ({note})")
    return [f"pins: {lines[0]}", *(f"      {line}" for line in lines[1:])]


def user_settings_file() -> Path:
    return Path.home() / ".claude" / "settings.json"


def enabled_plugins() -> list[str]:
    """SETUP-02: the plugins the user's Claude Code settings enable, in file order."""
    path = user_settings_file()
    if not path.exists():
        return []
    enabled = json.loads(path.read_text()).get("enabledPlugins") or {}
    return [plugin_id for plugin_id, on in enabled.items() if on]


def turn_off_user_plugins() -> list[str]:
    """RIG-12: set each plugin the user's settings enable to false, returning those plugins.

    Edits the text rather than re-serializing, so the file's layout and its blank-line groups (SETUP-04a)
    survive."""
    on = enabled_plugins()
    if not on:
        return []
    path = user_settings_file()
    text = path.read_text()
    block = re.search(r'"enabledPlugins"\s*:\s*\{(.*?)\}', text, re.DOTALL)
    edited = text[:block.start(1)] + re.sub(r'("[^"]+"\s*:\s*)true\b', r"\1false", block.group(1)) + text[block.end(1):]
    left_on = [p for p, value in (json.loads(edited).get("enabledPlugins") or {}).items() if value]
    if left_on:
        fail(f"couldn't turn off {', '.join(left_on)} in {path}; set them to false there, then launch again.")
    path.write_text(edited)
    return on


def enabled_groups() -> list[list[str]]:
    """SETUP-04a: the enabledPlugins entries as the blank-line groups the settings file shows them in.

    Read as text, since a JSON parse drops the blank lines."""
    path = user_settings_file()
    text = path.read_text() if path.exists() else ""
    match = re.search(r'"enabledPlugins"\s*:\s*\{(.*?)\}', text, re.DOTALL)
    if not match:
        return []
    groups, current = [], []
    for line in match.group(1).splitlines():
        entry = re.match(r'\s*"([^"]+)"\s*:\s*true\b', line)
        if entry:
            current.append(entry.group(1))
        elif not line.strip() and current:
            groups.append(current)
            current = []
    return groups + ([current] if current else [])


RIG_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def suggestions(outside: list[str], groups: list[list[str]]) -> list[tuple[str | None, list[str]]]:
    """SETUP-04a/b: (suggested name, plugins) for each group of plugins outside every rig."""
    if len(groups) > 1:
        return [(None, kept) for group in groups if (kept := [p for p in group if p in outside])]
    by_market: dict[str, list[str]] = {}
    for plugin_id in outside:
        by_market.setdefault(plugin_id.partition("@")[2] or plugin_id, []).append(plugin_id)
    return sorted(by_market.items(), key=lambda item: item[0].casefold())


class Refused(Exception):
    """An edit the rig editor won't make; the message says why."""


class RigEdits:
    """The rig definitions as the rig editor changes them, apart from the screen that shows them."""

    def __init__(self, config: dict | None, enabled: list[str], groups: list[list[str]], installed: list[str]):
        self.first_run = config is None or not config["rigs"]
        config = config or {"default": None, "clones": {}, "rigs": {}}
        self.clones = config.get("clones") or {}
        self.rigs = {name: {"plugins": list(rig["plugins"]), "extends": rig["extends"]}
                     for name, rig in config["rigs"].items()}
        self.default = config.get("default")
        if self.first_run:
            self.rigs = {"base": {"plugins": list(enabled), "extends": None}}
            self.default = "base"
        self.enabled = enabled
        self.groups = groups
        named = {p for rig in self.rigs.values() for p in rig["plugins"]}
        self.candidates = sorted(set(installed) | set(enabled) | named,
                                 key=lambda p: (p.partition("@")[2], p.partition("@")[0]))
        self.dirty = self.first_run

    @property
    def base(self) -> str | None:
        """The one rig that extends no other."""
        return next((name for name, rig in self.rigs.items() if rig["extends"] is None), None)

    def lineage(self, name: str) -> list[str]:
        """The rigs the named rig extends, nearest first, stopping short of a cycle."""
        chain: list[str] = []
        parent = self.rigs[name]["extends"]
        while parent in self.rigs and parent not in chain and parent != name:
            chain.append(parent)
            parent = self.rigs[parent]["extends"]
        return chain

    def children(self, name: str) -> list[str]:
        """EDITOR-12: the rigs that extend the named rig, in alphabetical order."""
        return sorted((other for other, rig in self.rigs.items() if rig["extends"] == name), key=str.casefold)

    def inherited(self, name: str) -> dict[str, str]:
        """EDITOR-04: each plugin the rig gets from the rigs it extends, with the rig that names it."""
        sources: dict[str, str] = {}
        for rig in reversed(self.lineage(name)):
            for plugin_id in self.rigs[rig]["plugins"]:
                sources.setdefault(plugin_id, rig)
        return sources

    def loads(self, name: str) -> set[str]:
        return set(self.inherited(name)) | set(self.rigs[name]["plugins"])

    def drafts(self) -> list[tuple[str | None, list[str]]]:
        """SETUP-04: (suggested name, plugins) for each group of enabled plugins that no rig loads."""
        covered = {p for name in self.rigs for p in self.loads(name)}
        return suggestions([p for p in self.enabled if p not in covered], self.groups)

    def parent_choices(self, name: str | None) -> list[str]:
        """EDITOR-05: the rigs this one can extend without forming a cycle."""
        if name is None:
            return list(self.rigs)
        return [other for other in self.rigs if other != name and name not in self.lineage(other)]

    def check_name(self, name: str) -> None:
        if not RIG_NAME.fullmatch(name):
            raise Refused("A rig name is letters, digits, '.', '_', or '-', starting with a letter or digit.")
        if name in self.rigs:
            raise Refused(f"There's already a rig named {name}.")

    def toggle(self, name: str, plugin_id: str, on: bool) -> None:
        plugins = self.rigs[name]["plugins"]
        if on and plugin_id not in plugins:
            plugins.append(plugin_id)
            plugins.sort(key=str.casefold)
        elif not on and plugin_id in plugins:
            plugins.remove(plugin_id)
        self.dirty = True

    def create(self, name: str, extends: str, plugins: list[str] | None = None) -> None:
        self.check_name(name)
        if extends not in self.rigs:
            raise Refused("A new rig extends one rig; choose which.")
        self.rigs[name] = {"plugins": list(plugins or []), "extends": extends}
        self.dirty = True

    def keep_draft(self, index: int, name: str, extends: str) -> None:
        """SETUP-04: a draft becomes a rig once the user names it."""
        _, plugins = self.drafts()[index]
        self.create(name, extends, plugins)

    def set_extends(self, name: str, extends: str) -> None:
        if name == self.base:
            raise Refused(f"{name} is the base rig, which extends no other rig.")
        if extends not in self.parent_choices(name):
            raise Refused(f"{name} can't extend {extends}: {extends} extends {name}, which would form a cycle.")
        self.rigs[name]["extends"] = extends
        self.dirty = True

    def rename(self, name: str, new: str) -> None:
        """EDITOR-11: the rig takes the new name, as do the references to it."""
        if new == name:
            return
        self.check_name(new)
        self.rigs = {(new if rig == name else rig): definition for rig, definition in self.rigs.items()}
        for definition in self.rigs.values():
            if definition["extends"] == name:
                definition["extends"] = new
        if self.default == name:
            self.default = new
        self.dirty = True

    def edit(self, name: str, new: str, extends: str | None) -> None:
        """EDITOR-10: rename the rig and change the rig it extends, making neither change if either is refused."""
        if new != name:
            self.check_name(new)
        if extends != self.rigs[name]["extends"]:
            self.set_extends(name, extends)
        self.rename(name, new)

    def make_default(self, name: str) -> None:
        """EDITOR-06."""
        self.default = name
        self.dirty = True

    def delete(self, name: str) -> None:
        """EDITOR-07."""
        if name == self.base:
            raise Refused(f"{name} is the base rig, which every other rig extends.")
        children = self.children(name)
        if children:
            raise Refused(f"{name} can't be deleted while {', '.join(children)} "
                          f"{'extends' if len(children) == 1 else 'extend'} it.")
        if name == self.default:
            raise Refused(f"{name} is the default rig; mark another rig as the default first.")
        del self.rigs[name]
        self.dirty = True

    def save(self) -> None:
        """EDITOR-08, SETUP-03: the base rig first, then the rest, each rig's plugins in alphabetical order."""
        order = sorted(self.rigs, key=lambda name: (name != self.base, name.casefold()))
        rigs = {name: {**self.rigs[name], "plugins": sorted(self.rigs[name]["plugins"], key=str.casefold)}
                for name in order}
        save_config({"default": self.default, "clones": self.clones, "rigs": rigs})
        self.dirty = False


def open_edits() -> RigEdits:
    return RigEdits(load_config(), enabled_plugins(), enabled_groups(), list(installed_plugins()))


def editor_app(edits: RigEdits):
    """EDITOR-01..09: the rig editor as a Textual app over the edits."""
    from rich.text import Text
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, Vertical
    from textual.screen import ModalScreen, Screen
    from textual.widgets import Button, Footer, Input, Label, RadioButton, RadioSet, SelectionList, Static, Tree
    from textual.widgets.selection_list import Selection

    class RigDialog(ModalScreen):
        """A rig's name and, unless choices is None, the one rig it extends; dismisses with (name, extends)
        or None. `renaming` is the rig's current name, which the new name may keep."""

        BINDINGS = [Binding("escape", "cancel", "Cancel")]

        def __init__(self, title: str, name: str | None, choices: list[str] | None, extends: str | None,
                     renaming: str | None = None):
            super().__init__()
            self.heading, self.suggested, self.renaming = title, name, renaming
            self.choices, self.extends = choices, extends

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                yield Label(self.heading, id="dialog-title")
                yield Input(value=self.suggested or "", placeholder="rig name", id="name")
                if self.choices is None:
                    yield Label("The base rig extends no other rig.")
                else:
                    yield Label("Extends:")
                    with RadioSet(id="extends"):
                        for choice in self.choices:
                            yield RadioButton(Text(choice), value=choice == self.extends)
                yield Static("", id="dialog-error")
                with Horizontal(id="dialog-buttons"):
                    yield Button("OK", variant="primary", id="ok")
                    yield Button("Cancel", id="cancel")

        def on_input_submitted(self) -> None:
            self.submit()

        def on_button_pressed(self, event: Button.Pressed) -> None:
            if event.button.id == "ok":
                self.submit()
            else:
                self.dismiss(None)

        def action_cancel(self) -> None:
            self.dismiss(None)

        def submit(self) -> None:
            name = self.query_one("#name", Input).value.strip()
            error = self.query_one("#dialog-error", Static)
            extends = None
            if self.choices is not None:
                index = self.query_one("#extends", RadioSet).pressed_index
                if index < 0:
                    error.update("Choose the rig it extends.")
                    return
                extends = self.choices[index]
            if name != self.renaming:
                try:
                    edits.check_name(name)
                except Refused as refused:
                    error.update(str(refused))
                    return
            self.dismiss((name, extends))

    class SaveOnQuit(ModalScreen):
        """EDITOR-09: dismisses with "save", "discard", or None to go back to editing."""

        BINDINGS = [Binding("s", "answer('save')", "Save"), Binding("d", "answer('discard')", "Discard"),
                    Binding("escape", "answer(None)", "Back")]

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                yield Label("Save the changes before quitting?", id="dialog-title")
                with Horizontal(id="dialog-buttons"):
                    yield Button("Save (s)", variant="primary", id="save")
                    yield Button("Discard (d)", variant="error", id="discard")

        def on_mount(self) -> None:
            self.query_one("#save", Button).focus()

        def on_button_pressed(self, event: Button.Pressed) -> None:
            self.dismiss(event.button.id)

        def action_answer(self, choice: str | None) -> None:
            self.dismiss(choice)

    class RigTree(Tree):
        """The rigs pane: a click selects a rig, and enter or a double-click opens it for editing."""

        BINDINGS = [Binding("enter", "edit", "Edit", show=False)]

        def on_mount(self) -> None:
            self.auto_expand = False

        def action_edit(self) -> None:
            self.screen.action_edit()

    class Editor(Screen):
        BINDINGS = [
            Binding("n", "new_rig", "New rig"),
            Binding("e", "edit", "Edit"),
            Binding("d", "make_default", "Default"),
            Binding("x,delete", "delete", "Delete"),
            Binding("s", "save", "Save"),
            Binding("ctrl+s", "save", "Save", show=False),
            Binding("q,escape", "leave", "Quit"),
        ]

        def __init__(self):
            super().__init__()
            self.current: tuple[str, str | int] = ("rig", edits.default or edits.base or "")

        def compose(self) -> ComposeResult:
            if edits.first_run:
                yield Static("First-run setup: choose the base rig's plugins, keep any drafts as rigs, "
                             "then s to save and q to finish.", id="hint")
            with Horizontal():
                tree = RigTree("rigs", id="rigs")
                tree.show_root = False
                tree.border_title = "rigs"
                yield tree
                yield SelectionList(id="plugins")
            yield Footer()

        def on_mount(self) -> None:
            self.rebuild()
            self.query_one("#plugins", SelectionList).focus()

        def rig_label(self, name: str) -> Text:
            label = Text("★ " if name == edits.default else "  ")
            label.append(name, style="bold" if name == edits.default else "")
            return label

        def rebuild(self) -> None:
            """Redraw both panes from the edits, keeping the cursor on the current rig."""
            tree = self.query_one("#rigs", Tree)
            tree.clear()
            placed: set[str] = set()

            def place(node, name: str) -> None:
                placed.add(name)
                kids = [kid for kid in edits.children(name) if kid not in placed]
                drafts = edits.drafts() if name == edits.base else []
                child = node.add(self.rig_label(name), data=("rig", name), expand=True,
                                 allow_expand=bool(kids or drafts))
                for kid in kids:
                    place(child, kid)
                for index, (suggested, plugins) in enumerate(drafts):
                    label = Text(f"  draft: {suggested or 'unnamed'} ({len(plugins)})", style="dim italic")
                    child.add_leaf(label, data=("draft", index))

            if edits.base:
                place(tree.root, edits.base)
            for name in sorted((n for n in edits.rigs if n not in placed), key=str.casefold):
                place(tree.root, name)
            if self.current[0] == "draft" and self.current[1] >= len(edits.drafts()):
                self.current = ("rig", edits.default or edits.base or "")
            self.call_after_refresh(self.restore_cursor)
            self.show_plugins()

        def restore_cursor(self) -> None:
            tree = self.query_one("#rigs", Tree)
            stack = list(tree.root.children)
            while stack:
                node = stack.pop(0)
                if node.data == self.current:
                    tree.move_cursor(node)
                    return
                stack[:0] = list(node.children)

        def show_plugins(self) -> None:
            listing = self.query_one("#plugins", SelectionList)
            highlighted = listing.highlighted
            listing.clear_options()
            kind, key = self.current
            if kind == "draft":
                suggested, plugins = edits.drafts()[key]
                listing.border_title = f"draft: {suggested or 'unnamed'} (s saves it as a rig)"
                listing.add_options([Selection(p, p, True, disabled=True) for p in plugins])
                return
            if key not in edits.rigs:
                listing.border_title = "no rigs: n makes one"
                return
            rig = edits.rigs[key]
            inherited = edits.inherited(key)
            listing.border_title = f"{key}: extends {rig['extends']}" if rig["extends"] else f"{key}: the base rig"
            options = [Selection(Text.assemble(p, (f"  from {inherited[p]}", "dim")), p, True, disabled=True)
                       for p in edits.candidates if p in inherited]
            options += [Selection(p, p, p in rig["plugins"]) for p in edits.candidates if p not in inherited]
            listing.add_options(options)
            if options:
                listing.highlighted = min(highlighted or 0, len(options) - 1)

        def on_tree_node_highlighted(self, event: Tree.NodeHighlighted) -> None:
            if event.node.data and event.node.data != self.current:
                self.current = event.node.data
                self.show_plugins()

        def on_selection_list_selection_toggled(self, event: SelectionList.SelectionToggled) -> None:
            kind, key = self.current
            if kind != "rig" or event.selection_list.id != "plugins":
                return
            plugin_id = event.selection.value
            edits.toggle(key, plugin_id, plugin_id in event.selection_list.selected)
            self.rebuild()

        def selected_rig(self) -> str | None:
            kind, key = self.current
            if kind != "rig" or key not in edits.rigs:
                self.notify("Select a rig first.", severity="warning")
                return None
            return key

        def attempt(self, change, then: str | None = None) -> None:
            """Make the change, or show why it was refused; `then` is the rig to select after."""
            try:
                change()
            except Refused as refused:
                self.notify(str(refused), severity="error")
                return
            if then:
                self.current = ("rig", then)
            self.rebuild()

        def action_new_rig(self) -> None:
            def made(answer) -> None:
                if answer:
                    self.attempt(lambda: edits.create(*answer), then=answer[0])

            self.app.push_screen(RigDialog("New rig", None, edits.parent_choices(None),
                                           self.extends_default()), made)

        def extends_default(self) -> str | None:
            kind, key = self.current
            return key if kind == "rig" and key in edits.rigs else edits.base

        def save_draft(self, index: int) -> None:
            """SETUP-04: name the draft, then save it with the rest of the edits."""
            suggested, _ = edits.drafts()[index]

            def kept(answer) -> None:
                if answer:
                    self.attempt(lambda: edits.keep_draft(index, *answer), then=answer[0])
                    if answer[0] in edits.rigs:
                        self.save()

            self.app.push_screen(RigDialog("Save draft as a rig", suggested, edits.parent_choices(None),
                                           edits.base), kept)

        def action_edit(self) -> None:
            """EDITOR-10: a draft opens for saving as a rig, a rig for its name and the rig it extends."""
            kind, key = self.current
            if kind == "draft":
                self.save_draft(key)
                return
            if key not in edits.rigs:
                return

            def edited(answer) -> None:
                if answer:
                    self.attempt(lambda: edits.edit(key, *answer), then=answer[0])

            choices = None if key == edits.base else edits.parent_choices(key)
            self.app.push_screen(RigDialog(f"Edit {key}", key, choices, edits.rigs[key]["extends"], key), edited)

        def on_click(self, event) -> None:
            if event.chain == 2 and isinstance(event.widget, RigTree):
                self.action_edit()

        def action_make_default(self) -> None:
            if (name := self.selected_rig()) is not None:
                self.attempt(lambda: edits.make_default(name))

        def action_delete(self) -> None:
            if (name := self.selected_rig()) is not None:
                self.attempt(lambda: edits.delete(name), then=edits.rigs[name]["extends"])

        def action_save(self) -> None:
            kind, key = self.current
            if kind == "draft":
                self.save_draft(key)
            else:
                self.save()

        def save(self) -> None:
            edits.save()
            self.notify(f"Saved to {display(rigs_file())}")

        def action_leave(self) -> None:
            if not edits.dirty:
                self.app.exit()
                return
            def chosen(choice: str | None) -> None:
                if choice == "save":
                    edits.save()
                if choice:
                    self.app.exit()

            self.app.push_screen(SaveOnQuit(), chosen)

    class RigEditor(App):
        TITLE = "rig setup"
        CSS = """
        #hint { padding: 0 1; background: $boost; }
        #rigs { width: 40; height: 1fr; border: round $primary; }
        #plugins { width: 1fr; height: 1fr; border: round $primary; }
        #rigs:focus-within, #plugins:focus { border: round $accent; }
        RigDialog, SaveOnQuit { align: center middle; }
        #dialog { width: 60; height: auto; max-height: 80%; border: thick $primary; background: $surface; padding: 1 2; }
        #dialog-title { text-style: bold; margin-bottom: 1; }
        #dialog-error { color: $error; }
        #dialog #extends { height: auto; max-height: 12; width: 1fr; }
        #dialog-buttons { height: auto; margin-top: 1; }
        #dialog-buttons Button { margin-right: 2; }
        """

        def on_mount(self) -> None:
            self.push_screen(Editor())

    return RigEditor()


def setup() -> None:
    """SETUP-01..05: open the rig editor on the rig definitions, or on a new base rig."""
    editor_app(open_edits()).run()


def save_config(config: dict) -> None:
    data = {"default": config["default"]}
    if config.get("clones"):
        data["clones"] = config["clones"]
    data["rigs"] = {name: {k: v for k, v in rig.items() if v not in ([], None, False)}
                    for name, rig in config["rigs"].items()}
    write_yaml(rigs_file(), data)


def cmd_setup(args: list[str]) -> int:
    """SETUP-05."""
    if args:
        fail("setup takes no arguments.")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        fail("setup opens the rig editor, so it needs a terminal.")
    setup()
    return 0


def cmd_complete(args: list[str]) -> int:
    """Values for tab completion that the zsh script can't read off disk itself."""
    if args != ["pinnable"]:
        fail("complete takes: pinnable")
    pinned = {Path(p["path"]) for p in read_pins()}
    clones = clone_roots()
    try:
        names = sorted({plugin["name"] for _, _, plugin in marketplace_plugins()})
    except Unresolved:
        return 0
    for name in names:
        try:
            path = resolve_name(name, clones)
        except Unresolved:
            continue
        if path.resolve() not in pinned:
            print(f"{name}:{display(path)}")
    return 0


WRAPPER = Path.home() / ".local" / "bin" / "rig"
COMPLETION_DIR = Path.home() / ".zsh" / "completions"
SNIPPET = Path.home() / ".zsh" / "rig.zsh"
SNIPPET_SENTINEL = "# rig: claude runs rig"
FPATH_LINE = "fpath=(~/.zsh/completions $fpath)"


def wrapper_text(script: Path) -> str:
    return f'#!/bin/sh\nexec uv run --quiet --script "{script}" "$@"\n'


def is_active(line: str) -> bool:
    return bool(line.strip()) and not line.lstrip().startswith("#")


def make_zsh_dir(path: Path) -> None:
    """Create path and its parents under HOME without group or world write, whatever the umask:
    compinit refuses a completion directory that others can write to."""
    for folder in reversed([path, *path.parents]):
        if folder.is_relative_to(Path.home()) and folder != Path.home() and not folder.exists():
            folder.mkdir(mode=0o755)


def runs_compinit(line: str) -> bool:
    return is_active(line) and re.search(r"\bcompinit\b", line) is not None


def puts_completions_on_fpath(line: str) -> bool:
    return is_active(line) and ".zsh/completions" in line


def install_wrapper() -> None:
    script = (PLUGIN_ROOT / "scripts" / "rig").resolve()
    text = wrapper_text(script)
    if WRAPPER.is_file() and WRAPPER.read_text() == text:
        print(f"  ✓ already installed: {WRAPPER} -> {script}")
    else:
        WRAPPER.parent.mkdir(parents=True, exist_ok=True)
        WRAPPER.write_text(text)
        WRAPPER.chmod(0o755)
        print(f"  ✓ wrote {WRAPPER} -> {script}")
    on_path = {Path(p).expanduser().resolve() for p in os.environ.get("PATH", "").split(os.pathsep) if p}
    if WRAPPER.parent.resolve() not in on_path:
        print(f"  ! {WRAPPER.parent} is not on PATH; add it in ~/.zshrc")


def install_completions() -> None:
    make_zsh_dir(COMPLETION_DIR)
    target = COMPLETION_DIR / "_rig"
    target.write_text(ZSH_COMPLETION)
    print(f"  ✓ wrote {target}")
    zshrc = Path.home() / ".zshrc"
    content = zshrc.read_text() if zshrc.exists() else ""
    lines = content.splitlines(keepends=True)
    if any(puts_completions_on_fpath(line) for line in lines):
        print(f"  ✓ {zshrc} already puts ~/.zsh/completions on fpath")
        return
    at = next((i for i, line in enumerate(lines) if runs_compinit(line)), None)
    if at is None:
        if content and not content.endswith("\n"):
            lines.append("\n")
        lines += [f"{FPATH_LINE}\n", "autoload -Uz compinit && compinit\n"]
        print(f"  ✓ added fpath and compinit to {zshrc}")
    else:
        lines.insert(at, f"{FPATH_LINE}\n")
        print(f"  ✓ added fpath before compinit in {zshrc}")
    zshrc.write_text("".join(lines))


def claude_function_origin() -> str | None:
    """The file that defines a `claude` shell function in a new interactive zsh, or None."""
    result = subprocess.run(["zsh", "-ic", "whence -v claude"], capture_output=True, text=True,
                            stdin=subprocess.DEVNULL)
    last = (result.stdout.strip().splitlines() or [""])[-1]
    match = re.match(r"^claude is a shell function(?: from (.+))?$", last)
    if not match:
        return None
    return match.group(1) or "an unknown file"


SNIPPET_TEXT = f"""{SNIPPET_SENTINEL}: written by `rig install-cli`.
claude() {{ rig claude "$@" }}
# A later compinit drops an earlier compdef, so register at the first prompt.
autoload -Uz add-zsh-hook
_rig_compdef_claude() {{
  compdef _rig claude
  add-zsh-hook -d precmd _rig_compdef_claude
}}
add-zsh-hook precmd _rig_compdef_claude
"""


def install_claude_function() -> None:
    """SHELL-04: make `claude` run rig, unless another shell function already defines claude."""
    origin = claude_function_origin()
    if origin and Path(origin).expanduser() != SNIPPET:
        print(f"  · claude is a shell function from {origin}; left as is")
        return
    make_zsh_dir(SNIPPET.parent)
    SNIPPET.write_text(SNIPPET_TEXT)
    zshrc = Path.home() / ".zshrc"
    content = zshrc.read_text() if zshrc.exists() else ""
    if SNIPPET_SENTINEL in content:
        print(f"  ✓ claude runs rig ({SNIPPET})")
        return
    with zshrc.open("a") as f:
        if content and not content.endswith("\n"):
            f.write("\n")
        f.write(f"source ~/.zsh/rig.zsh  {SNIPPET_SENTINEL}\n")
    print(f"  ✓ claude runs rig from new shells ({SNIPPET}, sourced from {zshrc})")


def cmd_install_cli(args: list[str]) -> int:
    """SHELL-01, SHELL-04."""
    if args:
        fail(f"install-cli takes no arguments, not {' '.join(args)}")
    import shutil
    if not shutil.which("uv"):
        fail("uv is not on PATH; rig runs through it. Install it: https://docs.astral.sh/uv/")
    install_wrapper()
    install_completions()
    install_claude_function()
    print("Open a new shell (or run: exec zsh) to pick up the changes.")
    return 0


def wrapper_target() -> Path | None:
    """The absolute script path the installed wrapper execs, or None without a wrapper."""
    if not WRAPPER.is_file():
        return None
    match = re.search(r'"(/[^"]+)"', WRAPPER.read_text())
    return Path(match.group(1)) if match else None


def in_plugin_cache(path: Path) -> bool:
    parts = path.parts
    return any(parts[i:i + 2] == ("plugins", "cache") for i in range(len(parts) - 1))


def cmd_freshness(args: list[str]) -> int:
    """SHELL-02: report a wrapper that no longer runs this install."""
    target = wrapper_target()
    this_script = (PLUGIN_ROOT / "scripts" / "rig").resolve()
    if target is None or target.resolve() == this_script:
        return 0
    if target.is_file() and not in_plugin_cache(target):
        return 0
    state = "is gone" if not target.is_file() else "is an older install"
    print(json.dumps({
        "systemMessage": f"rig: {INSTALL_COMMAND}  # cli is outdated",
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": (
                f"The rig command at {WRAPPER} runs {target}, which {state}. The loaded plugin is at "
                f"{PLUGIN_ROOT}. {INSTALL_COMMAND} repoints the wrapper; `rig install-cli` from the shell "
                "would run the old copy and keep the old path. The command is the user's to run."),
        },
    }))
    return 0


ZSH_COMPLETION = r"""#compdef rig

_rig_help_commands() {
  local cache=$1 tag=$2
  shift 2
  (( ${(P)+cache} )) || typeset -ga $cache
  if (( ! ${(P)#cache} )); then
    local line name listing=0
    local -a found
    for line in ${(f)"$(command claude "$@" --help 2>/dev/null)"}; do
      [[ $line == Commands:* ]] && { listing=1; continue }
      (( listing )) && [[ $line =~ '^  ([a-z][a-z|-]*)( [^ ]+)*  +(.*)$' ]] || continue
      for name in ${(s:|:)match[1]}; do found+=("$name:$match[3]"); done
    done
    set -A $cache $found
  fi
  (( ${(P)#cache} )) && _describe -t commands $tag $cache
}

_rig_names() {
  local file=~/.rig/rigs.yml
  [[ -r $file ]] || return 1
  local -a names=(${(f)"$(awk '/^rigs:/ { in_rigs = 1; next } /^[^ ]/ { in_rigs = 0 }
    in_rigs && /^  [^ #-][^:]*:/ { sub(/^  /, ""); sub(/:.*/, ""); print }' $file 2>/dev/null)"})
  (( $#names )) && compadd -a names
}

_rig_pinned() {
  local file=~/.rig/pins.yml
  [[ -r $file ]] || return 1
  local -a names=(${(f)"$(awk '/^[- ] plugin: / { sub(/^[- ] plugin: /, ""); print }' $file 2>/dev/null)"})
  (( $#names )) && compadd -a names
}

_rig_pinnable() {
  local -a pinnable=(${(f)"$(command rig complete pinnable 2>/dev/null)"})
  (( $#pinnable )) && _describe -t pinnable 'plugin with a local clone' pinnable
}

_rig() {
  local -a commands=(
    'use:Launch Claude Code with a named rig'
    'list:List the rigs with their plugins'
    'setup:Edit the rigs in a full-screen editor'
    'pin:Use a local plugin checkout in place of the installed copy; bare pin lists the pins'
    'unpin:Stop using a pinned checkout'
    'install-cli:Put rig on PATH with completions, and make claude run rig'
    'doctor:Check the rig command, the claude function, and tab completion, then run claude doctor'
  )
  local ret=1
  if [[ $words[2] == rig ]]; then
    words=($words[1] $words[3,-1])
    (( CURRENT-- ))
  elif (( CURRENT == 2 )) && [[ $service == claude ]] && [[ $PREFIX != -* ]]; then
    local -a prefix=('rig:rig commands')
    _describe -t rig-prefix 'rig' prefix && ret=0
  fi
  if (( CURRENT == 2 )); then
    if [[ $PREFIX == -* ]]; then
      local -a flags=('--sandbox:Run Bash in the sandbox, with no unsandboxed commands'
                      '--help:Show rig help' '--version:Show rig version')
      _describe -t rig-flags 'rig flag' flags && ret=0
    else
      _describe -t rig-commands 'rig command' commands && ret=0
      _rig_help_commands _rig_claude_cmds 'Claude Code command' && ret=0
    fi
    return ret
  fi
  if [[ $words[2] == (plugin|plugins) ]]; then
    if (( CURRENT == 3 )); then
      local -a taken=('pin:Use a local plugin checkout in place of the installed copy (rig)'
                      'unpin:Stop using a pinned checkout (rig)')
      _describe -t rig-commands 'rig command' taken && ret=0
      _rig_help_commands _rig_plugin_cmds 'Claude Code plugin command' plugin && ret=0
      return ret
    fi
    [[ $words[3] == (pin|unpin) ]] && words=($words[1] $words[3,-1]) && (( CURRENT-- ))
  fi
  case $words[2] in
    use)
      if (( CURRENT == 3 )); then
        _rig_names
      elif [[ $PREFIX == -* ]]; then
        compadd -- --sandbox
      else
        _default
      fi
      ;;
    pin)
      local ret=1
      _rig_pinnable && ret=0
      _directories && ret=0
      return ret
      ;;
    unpin) _rig_pinned ;;
    *) _default ;;
  esac
}

_rig "$@"
"""


def cmd_completions(args: list[str]) -> int:
    if args != ["zsh"]:
        fail("completions takes one shell: zsh")
    sys.stdout.write(ZSH_COMPLETION)
    return 0


DOCTOR_PROBE = r"""
typeset -a found=(${^fpath}/_rig(N))
print -r -- "rig-doctor rig=$(whence -p rig)"
print -r -- "rig-doctor claude=$(whence -v claude)"
print -r -- "rig-doctor completer=$found[1]"
print -r -- "rig-doctor compinit=$+functions[compdef]"
print -r -- "rig-doctor comp-rig=$_comps[rig]"
print -r -- "rig-doctor comp-claude=$_comps[claude]"
print -r -- "rig-doctor compdef-pending=$precmd_functions[(I)_rig_compdef_claude]"
"""


def shell_probe() -> dict[str, str] | None:
    """What a new interactive zsh sees, as DOCTOR_PROBE reports it; None when zsh isn't on PATH."""
    import shutil
    if not shutil.which("zsh"):
        return None
    try:
        result = subprocess.run(["zsh", "-ic", DOCTOR_PROBE], capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, timeout=30)
    except subprocess.TimeoutExpired:
        fail("a new interactive zsh didn't finish starting within 30 seconds; check ~/.zshrc.")
    return dict(line.removeprefix("rig-doctor ").split("=", 1)
                for line in result.stdout.splitlines() if line.startswith("rig-doctor "))


def installed_rig_script() -> Path | None:
    """scripts/rig in the rig plugin build installed at user scope, or None."""
    for plugin_id, entries in installed_plugins().items():
        if plugin_id.partition("@")[0] != "rig":
            continue
        for entry in entries:
            if entry.get("scope") == "user" and entry.get("installPath"):
                return Path(entry["installPath"]) / "scripts" / "rig"
    return None


Check = tuple[bool, str, str]
FIX_INSTALL = f"run {INSTALL_COMMAND} in Claude Code"


def same_file(a: Path | str, b: Path) -> bool:
    return Path(a).expanduser().resolve() == b.expanduser().resolve()


def check_rig_on_path(probe: dict[str, str]) -> Check:
    """DOCTOR-01."""
    found = probe.get("rig", "")
    if not found:
        fix = f"add {display(WRAPPER.parent)} to PATH in ~/.zshrc" if WRAPPER.is_file() else FIX_INSTALL
        return False, "a new zsh finds no rig on PATH", fix
    if not same_file(found, WRAPPER):
        return (False, f"rig on PATH is {display(found)}, not {display(WRAPPER)}",
                f"remove {display(found)}, or put {display(WRAPPER.parent)} ahead of it on PATH")
    target = wrapper_target()
    if target is None:
        return False, f"{display(WRAPPER)} doesn't run a rig script", FIX_INSTALL
    if not target.is_file():
        return False, f"rig runs {display(target)}, which is gone", FIX_INSTALL
    if not in_plugin_cache(target):
        return True, f"rig runs the checkout at {display(target.parent.parent)}", ""
    installed = installed_rig_script()
    if installed is None:
        return (False, f"rig runs {display(target)}, but the rig plugin isn't installed",
                f"install rig with /plugin, then {FIX_INSTALL}")
    if not same_file(target, installed):
        return False, f"rig runs {display(target)}, not the installed {display(installed)}", FIX_INSTALL
    return True, f"rig runs the installed plugin at {display(installed.parent.parent)}", ""


def check_claude_runs_rig(probe: dict[str, str]) -> Check:
    """DOCTOR-02."""
    found = probe.get("claude", "")
    match = re.match(r"^claude is a shell function(?: from (.+))?$", found)
    if not match:
        return False, f"in a new zsh, {found or 'claude is not found'}", FIX_INSTALL
    origin = match.group(1)
    if origin is None or not same_file(origin, SNIPPET):
        where = display(origin) if origin else "an unknown file"
        return (False, f"claude is a shell function from {where}",
                f"remove that claude function, then {FIX_INSTALL}")
    if SNIPPET.read_text() != SNIPPET_TEXT:
        return False, f"{display(SNIPPET)} is out of date", FIX_INSTALL
    return True, f"claude runs rig ({display(SNIPPET)})", ""


def check_rig_completion(probe: dict[str, str]) -> Check:
    """DOCTOR-03, for rig."""
    target = COMPLETION_DIR / "_rig"
    if not target.is_file() or target.read_text() != ZSH_COMPLETION:
        state = "out of date" if target.is_file() else "missing"
        return False, f"{display(target)} is {state}", FIX_INSTALL
    found = probe.get("completer", "")
    if not found:
        return False, f"a new zsh doesn't have {display(COMPLETION_DIR)} on fpath", FIX_INSTALL
    if not same_file(found, target):
        return False, f"a new zsh loads _rig from {display(found)} first", f"remove {display(found)}"
    if probe.get("compinit") != "1":
        return False, "compinit didn't run in a new zsh", FIX_INSTALL
    if probe.get("comp-rig") != "_rig":
        return False, "compinit didn't register rig's completion", unregistered_completion_fix()
    return True, "zsh completes rig", ""


def unregistered_completion_fix() -> str:
    """Where ~/.zshrc puts the completions on fpath ahead of compinit, compinit read a dump written
    before _rig existed (as `compinit -C` does, skipping the check for new files)."""
    zshrc = Path.home() / ".zshrc"
    lines = zshrc.read_text().splitlines() if zshrc.is_file() else []
    fpath_at = next((i for i, line in enumerate(lines) if puts_completions_on_fpath(line)), None)
    compinit_at = next((i for i, line in enumerate(lines) if runs_compinit(line)), None)
    if fpath_at is not None and (compinit_at is None or fpath_at < compinit_at):
        return "rm ~/.zcompdump*, then open a new shell; compinit read a dump from before rig's completion"
    return f"put `{FPATH_LINE}` before compinit in ~/.zshrc"


def check_claude_completion(probe: dict[str, str]) -> Check:
    """DOCTOR-03, for claude."""
    if probe.get("comp-claude") == "_rig" or int(probe.get("compdef-pending") or 0) > 0:
        return True, "zsh completes claude as rig", ""
    return False, "zsh doesn't complete claude as rig", FIX_INSTALL


def cmd_doctor(args: list[str]) -> int:
    """DOCTOR-01..05: check what a new zsh sees, then run Claude Code's doctor."""
    probe = shell_probe()
    if probe is None:
        checks = [(False, "zsh isn't on PATH, and rig's shell setup is for zsh", "install zsh")]
    else:
        checks = [check(probe) for check in
                  (check_rig_on_path, check_claude_runs_rig, check_rig_completion, check_claude_completion)]
    print("rig shell setup:")
    for ok, what, fix in checks:
        print(f"  {'✓' if ok else '✗'} {what}")
        if not ok:
            print(f"      fix: {fix}")
    print(flush=True)
    try:
        status = subprocess.run(["claude", "doctor", *args]).returncode
    except FileNotFoundError:
        fail("claude is not on PATH.")
    return 1 if not all(ok for ok, _, _ in checks) else status


USAGE = f"""usage: rig <command> [<args>...]
       rig <claude args>...            launch Claude Code with the default rig

Commands:
  use <rig> [<claude args>]  launch Claude Code with the named rig
  list                       list the rigs with their plugins
  setup                      edit the rigs in a full-screen editor: their plugins, the
                             rig each extends, and the default
  pin [<path|name>...]       use a local plugin checkout in place of the installed copy;
                             with no arguments, list the pins
  unpin <path|name>...       stop using a pinned checkout
  install-cli                put rig on PATH with tab completion, and make claude run rig
  doctor                     check the rig command, the claude function, and tab completion
                             in a new zsh, then run Claude Code's doctor

Anything else goes to Claude Code: its subcommands run unchanged, and other
arguments start a session with the default rig. The install makes `claude` run
`rig claude`, which does the same, and launches the default rig when given no
arguments. `rig rig <command>` is the same as `rig <command>`.

  --sandbox                  with a launch: run Bash in Claude Code's sandbox, failing if
                             it's unavailable and allowing no unsandboxed commands
  -h, --help, help           show this help
  --version                  show rig's version
"""

COMMANDS = {
    "use": cmd_use,
    "list": cmd_list,
    "setup": cmd_setup,
    "pin": cmd_pin,
    "unpin": cmd_unpin,
    "install-cli": cmd_install_cli,
    "doctor": cmd_doctor,
    "completions": cmd_completions,
    "complete": cmd_complete,
    "freshness": cmd_freshness,
    "switch": cmd_switch,
}
UNCOMPLETED_COMMANDS = {"completions", "complete", "freshness", "switch"}
CLAUDE_SUBCOMMANDS_TAKEN = {"plugin": ("pin", "unpin"), "plugins": ("pin", "unpin")}


def main(argv: list[str]) -> int:
    as_claude = argv[:1] == ["claude"]
    if as_claude:
        argv = argv[1:]
    if argv[:1] == ["rig"]:
        argv = argv[1:]
        as_claude = False
    elif argv[:1] and argv[1:2] and argv[1] in CLAUDE_SUBCOMMANDS_TAKEN.get(argv[0], ()):
        argv = argv[1:]
    if not argv and not as_claude:
        print(USAGE, end="")
        return 0
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(USAGE, end="")
        return 0
    if argv[:1] == ["--version"]:
        print(f"rig {version_display()}")
        return 0
    if argv and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:])
    if argv and not argv[0].startswith("-") and argv[0] in claude_subcommands():
        exec_claude(argv)
    launch(None, argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
